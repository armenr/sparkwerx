#!/usr/bin/env bash
set -euo pipefail

# Read-only fleet plan. This intentionally works before Nix is installed: the
# host/role declaration and bootstrap pin are plain JSON. When the exact Nix
# runtime is already available, the plan supplements them with evaluated Home
# output and live drift information. Nix evaluation can fetch missing locked
# flake sources into the store; the command never installs a package, changes a
# profile, activates configuration, restarts a service, enrolls a node, or
# reboots the host.

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fleet_file=$repo_dir/fleet/hosts.json
bootstrap_file=$repo_dir/bootstrap/nix/source.json
nix_bin=/nix/var/nix/profiles/default/bin/nix
nix_args=(--extra-experimental-features "nix-command flakes")

usage() {
  printf 'Usage: %s <plan | bootstrap | apply | converge> [HOSTNAME]\n' "$(basename "$0")" >&2
}

die() {
  printf 'FAIL|%s\n' "$1" >&2
  exit 1
}

emit() {
  printf '%s|%s|%s\n' "$1" "$2" "$3"
}

json_value() {
  local file=$1 expression=$2
  python3 - "$file" "$expression" <<'PY'
import json
import sys

path, expression = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    value = json.load(handle)
for component in expression.split("."):
    if component:
        value = value[component]
if isinstance(value, bool):
    print(str(value).lower())
elif isinstance(value, (str, int)):
    print(value)
else:
    raise SystemExit(f"{expression} is not a scalar")
PY
}

validate_inputs() {
  python3 - "$fleet_file" "$bootstrap_file" "$1" <<'PY'
import json
import re
import sys

fleet_path, bootstrap_path, host_name = sys.argv[1:]
with open(fleet_path, encoding="utf-8") as handle:
    fleet = json.load(handle)
with open(bootstrap_path, encoding="utf-8") as handle:
    bootstrap = json.load(handle)

if fleet.get("schemaVersion") != 1:
    raise SystemExit("fleet schemaVersion must be 1")
if host_name not in fleet.get("hosts", {}):
    raise SystemExit(f"host is not declared in fleet/hosts.json: {host_name}")
host = fleet["hosts"][host_name]
required_host = {"system", "pilotRing", "users", "fleetBase", "access", "desktop", "workloads"}
if set(host) != required_host:
    raise SystemExit("host declaration has missing or unknown top-level fields")
if host["system"] != "aarch64-linux":
    raise SystemExit("DGX Spark host system must be aarch64-linux")
if host["desktop"]["mode"] not in {"headless", "gnome", "hyprland", "kde"}:
    raise SystemExit("desktop mode is invalid")
if host["desktop"].get("hostController") not in {"not-implemented", "system-manager"}:
    raise SystemExit("desktop host controller is invalid")
if (host["desktop"]["hostController"] == "system-manager" and
        host["desktop"]["mode"] not in {"headless", "gnome"}):
    raise SystemExit("the current System Manager controller supports only headless or gnome")
if host["desktop"]["mode"] != "hyprland" and host["desktop"]["hyprlandPortal"]:
    raise SystemExit("Hyprland portal cannot be selected outside Hyprland mode")
if not host["fleetBase"]["enable"]:
    raise SystemExit("managed hosts must enable the exact fleet base")
if set(host["users"]) != {"armen"}:
    raise SystemExit("the current fleet schema requires one explicit armen mapping")
user = host["users"]["armen"]
if not re.fullmatch(r"[a-z_][a-z0-9_-]*", user["unixName"]):
    raise SystemExit("managed Unix user name is invalid")
if user["homeDirectory"] != f"/home/{user['unixName']}":
    raise SystemExit("managed homeDirectory must match the Unix user")
if host["access"]["tailscale"]["ownership"] not in {
    "disabled", "migration-pending-apt", "nix-managed"
}:
    raise SystemExit("Tailscale ownership state is invalid")
if bootstrap.get("schemaVersion") != 1:
    raise SystemExit("Nix bootstrap schemaVersion must be 1")
installer = bootstrap["installer"]
if installer["asset"] != "nix-installer-aarch64-linux":
    raise SystemExit("Nix bootstrap asset is not ARM64 Linux")
if not re.fullmatch(r"[0-9a-f]{64}", installer["sha256"]):
    raise SystemExit("Nix installer SHA-256 is invalid")
if not bootstrap["linuxPlanner"]["enableFlakes"]:
    raise SystemExit("the repository bootstrap requires flakes")
if bootstrap["linuxPlanner"]["init"] != "systemd":
    raise SystemExit("the repository bootstrap requires systemd")
if not bootstrap["linuxPlanner"]["startDaemon"]:
    raise SystemExit("the repository bootstrap must start the daemon")
if not bootstrap["linuxPlanner"]["modifyProfile"]:
    raise SystemExit("the repository bootstrap must configure shell profiles")
if bootstrap["linuxPlanner"]["addChannel"]:
    raise SystemExit("the repository bootstrap must not add a Nix channel")
PY
}

os_value() {
  local key=$1 file=$2 value
  value="$(sed -n "s/^${key}=//p" "$file" 2>/dev/null | head -n 1)"
  value=${value#\"}
  value=${value%\"}
  printf '%s\n' "$value"
}

plan_host() {
  local target_host=$1 actual_host actual_user actual_arch declared_user declared_home
  local declared_system desktop_mode portal host_controller
  local tailscale_selected tailscale_ssh tailscale_owner
  local isaac_selected isaac_enabled llmster_selected llmster_enabled
  local installer_version installer_sha installer_size installer_url desired_nix
  local repo_state dgx_name dgx_version ubuntu_version observed_version observed_sha observed_size
  local runtime_version features candidate live_candidate closure status
  local tailscale_version tailscale_package tailscale_plan tailscale_generation
  local desktop_plan desktop_live desktop_candidate desktop_retained desktop_guard desktop_default
  local root_live="" fleet_factory="" fleet_headless="" fleet_guard=false
  local managed_fragment status_json prefs_json
  local partial=false

  validate_inputs "$target_host" || die 'fleet/bootstrap input validation failed'
  actual_host="$(hostname -s)"
  actual_user="$(id -un)"
  actual_arch="$(uname -m)"
  declared_user="$(json_value "$fleet_file" "hosts.$target_host.users.armen.unixName")"
  declared_home="$(json_value "$fleet_file" "hosts.$target_host.users.armen.homeDirectory")"
  declared_system="$(json_value "$fleet_file" "hosts.$target_host.system")"
  desktop_mode="$(json_value "$fleet_file" "hosts.$target_host.desktop.mode")"
  portal="$(json_value "$fleet_file" "hosts.$target_host.desktop.hyprlandPortal")"
  host_controller="$(json_value "$fleet_file" "hosts.$target_host.desktop.hostController")"
  tailscale_selected="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.selected")"
  tailscale_ssh="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.sshDesired")"
  tailscale_owner="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.ownership")"
  isaac_selected="$(json_value "$fleet_file" "hosts.$target_host.workloads.isaacOmniverse.selected")"
  isaac_enabled="$(json_value "$fleet_file" "hosts.$target_host.workloads.isaacOmniverse.enabled")"
  llmster_selected="$(json_value "$fleet_file" "hosts.$target_host.workloads.lmstudioDaemon.selected")"
  llmster_enabled="$(json_value "$fleet_file" "hosts.$target_host.workloads.lmstudioDaemon.enabled")"
  installer_version="$(json_value "$bootstrap_file" installer.version)"
  installer_sha="$(json_value "$bootstrap_file" installer.sha256)"
  installer_size="$(json_value "$bootstrap_file" installer.size)"
  installer_url="$(json_value "$bootstrap_file" installer.url)"
  desired_nix="$(json_value "$bootstrap_file" desiredRuntime.version)"

  printf '# DGX declarative host plan\n'
  printf '# timestamp_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  emit INFO target "$target_host"
  emit INFO repository "$repo_dir@$(git -C "$repo_dir" rev-parse --short=12 HEAD)"
  repo_state=clean
  [[ -z "$(git -C "$repo_dir" status --porcelain=v1)" ]] || repo_state=dirty
  emit INFO repository_state "$repo_state"
  emit INFO declared_system "$declared_system"
  emit INFO declared_user "armen->$declared_user@$target_host;$declared_home"
  emit INFO fleet_base 'enabled;ncdu,lazydocker,devbox'
  emit INFO desktop "mode=$desktop_mode;hyprland_portal=$portal;host_controller=$host_controller"
  emit INFO armen_overlay "selected=$(json_value "$fleet_file" "hosts.$target_host.users.armen.overlaySelected");codex=$(json_value "$fleet_file" "hosts.$target_host.users.armen.codexSelected");graphical_apps=$(json_value "$fleet_file" "hosts.$target_host.users.armen.graphicalAppsSelected")"
  emit INFO tailscale "selected=$tailscale_selected;ssh_desired=$tailscale_ssh;ownership=$tailscale_owner"
  emit INFO isaac_omniverse "selected=$isaac_selected;enabled=$isaac_enabled"
  emit INFO lmstudio_daemon "selected=$llmster_selected;enabled=$llmster_enabled"

  if [[ "$target_host" != "$actual_host" ]]; then
    emit INFO observation_scope "declared host only; local machine is $actual_host"
    emit HOLD apply 'run the plan on the declared host before any apply'
    printf 'PLAN_STATUS=DECLARATION_ONLY\n'
    return
  fi

  [[ "$actual_arch" == aarch64 ]] || die "host architecture is $actual_arch, expected aarch64"
  [[ "$actual_user" == "$declared_user" ]] ||
    die "current user is $actual_user, expected $declared_user"
  [[ "$HOME" == "$declared_home" ]] || die "HOME is $HOME, expected $declared_home"
  ubuntu_version="$(os_value PRETTY_NAME /etc/os-release)"
  dgx_name="$(os_value DGX_PRETTY_NAME /etc/dgx-release)"
  dgx_version="$(os_value DGX_OTA_VERSION /etc/dgx-release)"
  emit PASS substrate "${dgx_name:-UNKNOWN};DGX_OS=${dgx_version:-UNKNOWN};${ubuntu_version:-UNKNOWN};serial_not_read"

  if [[ -x /nix/nix-installer ]]; then
    observed_version="$(/nix/nix-installer --version | awk '{print $2}')"
    observed_sha="$(sha256sum /nix/nix-installer | awk '{print $1}')"
    observed_size="$(stat -c %s /nix/nix-installer)"
    if [[ "$observed_version" == "$installer_version" &&
      "$observed_sha" == "$installer_sha" && "$observed_size" == "$installer_size" ]]; then
      emit PASS nix_bootstrap "adopt exact official installer $installer_version;sha256=$observed_sha"
    else
      emit HOLD nix_bootstrap "installed installer differs from pin $installer_version/$installer_sha/$installer_size"
    fi
  elif [[ -e /nix || -e /etc/nix ]]; then
    emit HOLD nix_bootstrap 'partial or foreign Nix surface exists; do not overwrite it'
  else
    emit ACTION nix_bootstrap "download=$installer_url;sha256=$installer_sha;plan=linux/systemd/32-build-users/flakes/profile/no-channel;no action performed"
  fi

  if [[ -x "$nix_bin" ]]; then
    runtime_version="$($nix_bin --version | awk '{print $3}')"
    if [[ "$runtime_version" == "$desired_nix" ]]; then
      emit PASS nix_runtime "$runtime_version"
    else
      emit HOLD nix_runtime "active=$runtime_version;desired=$desired_nix;use root/nix runbook"
    fi
    features="$($nix_bin config show experimental-features 2>/dev/null || true)"
    if [[ " $features " == *' flakes '* && " $features " == *' nix-command '* ]]; then
      emit PASS nix_features 'nix-command and flakes are persistent'
    else
      emit HOLD nix_features "persistent=${features:-NONE};commands currently add exact temporary features"
    fi

    candidate="$(cd "$repo_dir" && "$nix_bin" "${nix_args[@]}" eval --raw --no-write-lock-file \
      ".#homeConfigurations.\"$declared_user@$target_host\".activationPackage")"
    live_candidate="$(readlink -e "$declared_home/.local/state/nix/profiles/home-manager" 2>/dev/null || true)"
    closure=not-realized
    if [[ -e "$candidate" ]]; then
      closure="$($nix_bin path-info -Sh "$candidate" | awk '{$1=""; sub(/^ /, ""); print}')"
    fi
    status=READY
    [[ "$candidate" != "$live_candidate" ]] || status=CURRENT
    emit "$status" home "candidate=$candidate;live=${live_candidate:-ABSENT};closure=$closure"

    if [[ "$host_controller" == system-manager ]]; then
      fleet_factory="$(cd "$repo_dir" && "$nix_bin" "${nix_args[@]}" \
        eval --raw --no-write-lock-file \
        ".#lib.dgxFleetRootOutputs.aarch64-linux.\"$target_host\".factory")"
      fleet_headless="$(cd "$repo_dir" && "$nix_bin" "${nix_args[@]}" \
        eval --raw --no-write-lock-file \
        ".#lib.dgxFleetRootOutputs.aarch64-linux.\"$target_host\".headless")"
      root_live="$(readlink -f \
        /nix/var/nix/profiles/system-manager-profiles/system-manager 2>/dev/null || true)"
      [[ ! -e /var/lib/dgx-setup/fleet-bootstrap &&
        ! -L /var/lib/dgx-setup/fleet-bootstrap ]] || fleet_guard=true
    fi
  else
    emit HOLD home 'Nix bootstrap and exact 2.35.2 runtime must complete first'
  fi

  if [[ "$tailscale_selected" == true ]]; then
    if [[ "$tailscale_owner" == nix-managed &&
      ( "$root_live" == "$fleet_factory" || "$root_live" == "$fleet_headless" ) ]]; then
      tailscale_package="$(cd "$repo_dir" && "$nix_bin" "${nix_args[@]}" \
        eval --raw --no-write-lock-file .#packages.aarch64-linux.tailscale.outPath)"
      managed_fragment="$(jq -er '.["tailscaled.service"].storePath' \
        "$root_live/services/services.json")"
      [[ "$(systemctl show tailscaled.service -p FragmentPath --value 2>/dev/null || true)" == \
        "$managed_fragment" && "$(systemctl is-active tailscaled.service 2>/dev/null || true)" == active ]] ||
        die 'declared fresh-host generation does not own a healthy tailscaled.service'
      status_json="$("$tailscale_package/bin/tailscale" status --json 2>/dev/null)" ||
        die 'fresh-host Tailscale status is unavailable'
      prefs_json="$("$tailscale_package/bin/tailscale" debug prefs 2>/dev/null)" ||
        die 'fresh-host Tailscale preferences are unavailable'
      [[ "$(jq -r '.BackendState' <<<"$status_json")" == Running &&
        "$(jq -r '.Self.Online' <<<"$status_json")" == true &&
        "$(jq -r '.WantRunning' <<<"$prefs_json")" == true &&
        "$(jq -r '.RunSSH' <<<"$prefs_json")" == "$tailscale_ssh" ]] ||
        die 'fresh-host Nix-managed Tailscale is not online with declared preferences'
      tailscale_version="$("$tailscale_package/bin/tailscale" version --json 2>/dev/null | python3 -c \
        'import json,sys; value=json.load(sys.stdin); print(value.get("majorMinorPatch") or value.get("short") or value.get("long") or "UNKNOWN")')"
      emit PASS tailscale_apply "ownership=nix-managed;installed=$tailscale_version;managed_generation=$root_live;live and boot-linked"
    elif [[ "$tailscale_owner" == nix-managed && -x "$nix_bin" ]] &&
      tailscale_plan="$("$repo_dir/scripts/dgx-tailscale" plan 2>&1)" &&
      grep -Fq 'PASS|ownership|confirmed-nix-managed;generation=' <<<"$tailscale_plan"; then
      tailscale_package="$(sed -n 's/^INFO|tailscale_package|//p' <<<"$tailscale_plan")"
      [[ -x "$tailscale_package/bin/tailscale" ]] ||
        die 'verified Tailscale plan did not expose its exact Nix client'
      tailscale_version="$("$tailscale_package/bin/tailscale" version --json 2>/dev/null | python3 -c \
        'import json,sys; value=json.load(sys.stdin); print(value.get("majorMinorPatch") or value.get("short") or value.get("long") or "UNKNOWN")')"
      tailscale_generation="$(sed -n 's/^PASS|ownership|confirmed-nix-managed;generation=\([^;]*\).*/\1/p' <<<"$tailscale_plan" | head -n 1)"
      [[ -n "$tailscale_generation" ]] || die 'verified Tailscale plan omitted its managed generation'
      emit PASS tailscale_apply "ownership=nix-managed;installed=$tailscale_version;managed_generation=$tailscale_generation;live and boot-linked"
    elif [[ "$tailscale_owner" == migration-pending-apt ]] && command -v tailscale >/dev/null 2>&1; then
      tailscale_version="$(tailscale version --json 2>/dev/null | python3 -c \
        'import json,sys; value=json.load(sys.stdin); print(value.get("majorMinorPatch") or value.get("short") or value.get("long") or "UNKNOWN")')"
      emit HOLD tailscale_apply "ownership=migration-pending-apt;installed=$tailscale_version;use the separately gated migration operator"
      partial=true
    else
      emit HOLD tailscale_apply "declared ownership=$tailscale_owner does not match a verified live state"
      partial=true
    fi
  fi
  if [[ "$desktop_mode" == headless && "$host_controller" == system-manager && -x "$nix_bin" ]] &&
    [[ "$root_live" == "$fleet_headless" && "$fleet_guard" == false ]] &&
    [[ "$(systemctl get-default 2>/dev/null || true)" == default.target ]] &&
    systemctl is-active --quiet dgx-headless.target &&
    ! systemctl is-active --quiet graphical.target &&
    ! systemctl is-active --quiet gdm.service &&
    ! systemctl is-active --quiet dgx-dashboard.service; then
    emit PASS desktop_apply "mode=headless;controller=system-manager;generation=$fleet_headless;confirmed live and boot-persistent"
  elif [[ "$desktop_mode" == headless && "$host_controller" == system-manager && -x "$nix_bin" ]] &&
    desktop_plan="$("$repo_dir/scripts/dgx-desktop" plan 2>&1)"; then
    desktop_live="$(sed -n 's/^INFO|live_generation|//p' <<<"$desktop_plan" | head -n 1)"
    desktop_candidate="$(sed -n 's/^INFO|headless_generation|//p' <<<"$desktop_plan" | head -n 1)"
    desktop_retained="$(sed -n 's/^INFO|candidate_retention|//p' <<<"$desktop_plan" | head -n 1)"
    desktop_guard="$(sed -n 's/^INFO|guard|//p' <<<"$desktop_plan" | head -n 1)"
    desktop_default="$(sed -n 's/^INFO|current_default|//p' <<<"$desktop_plan" | head -n 1)"
    if [[ -n "$desktop_candidate" && "$desktop_live" == "$desktop_candidate" &&
      "$desktop_retained" == "$desktop_candidate" && "$desktop_guard" == absent &&
      "$desktop_default" == default.target ]]; then
      emit PASS desktop_apply "mode=headless;controller=system-manager;generation=$desktop_candidate;confirmed live and boot-persistent"
    else
      emit HOLD desktop_apply "declared headless controller does not match the retained live state"
      partial=true
    fi
  elif [[ "$desktop_mode" == headless && "$host_controller" == not-implemented ]]; then
    emit HOLD desktop_apply 'user composition is headless, but factory GNOME remains active until the root desktop controller is proven'
    partial=true
  else
    emit HOLD desktop_apply "desktop mode=$desktop_mode/controller=$host_controller is not yet apply-ready"
    partial=true
  fi
  if [[ "$isaac_enabled" != false || "$llmster_enabled" != false ]]; then
    emit HOLD workload_apply 'an enabled workload is not yet apply-ready'
    partial=true
  fi

  emit PASS plan 'no package build/install, profile, service, enrollment, desktop, or reboot action occurred; evaluation may fetch missing locked flake sources'
  if [[ "$partial" == true ]]; then
    printf 'PLAN_STATUS=PARTIAL_READY\n'
  else
    printf 'PLAN_STATUS=READY\n'
  fi
}

apply_host() {
  local target_host=$1 actual_host actual_user declared_user declared_home
  local desktop_mode host_controller tailscale_selected tailscale_owner
  local isaac_enabled llmster_enabled home_profile home_action
  local tailscale_preflight tailscale_status desktop_preflight desktop_status
  local partial=false

  validate_inputs "$target_host" || die 'fleet/bootstrap input validation failed'
  actual_host="$(hostname -s)"
  actual_user="$(id -un)"
  declared_user="$(json_value "$fleet_file" "hosts.$target_host.users.armen.unixName")"
  declared_home="$(json_value "$fleet_file" "hosts.$target_host.users.armen.homeDirectory")"
  desktop_mode="$(json_value "$fleet_file" "hosts.$target_host.desktop.mode")"
  host_controller="$(json_value "$fleet_file" "hosts.$target_host.desktop.hostController")"
  tailscale_selected="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.selected")"
  tailscale_owner="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.ownership")"
  isaac_enabled="$(json_value "$fleet_file" "hosts.$target_host.workloads.isaacOmniverse.enabled")"
  llmster_enabled="$(json_value "$fleet_file" "hosts.$target_host.workloads.lmstudioDaemon.enabled")"

  [[ "$target_host" == "$actual_host" ]] ||
    die "apply can target only the local host ($actual_host)"
  [[ "$actual_user" == "$declared_user" ]] ||
    die "current user is $actual_user, expected $declared_user"
  [[ "$HOME" == "$declared_home" ]] ||
    die "HOME is $HOME, expected $declared_home"
  [[ "$(uname -m)" == aarch64 ]] || die 'apply supports only aarch64 hosts'
  [[ -z "$(git -C "$repo_dir" status --porcelain=v1)" ]] ||
    die 'repository must be clean so apply binds one committed design'

  # The currently proven Home lifecycle is deliberately headless-only. Refuse
  # before bootstrap or profile mutation if a graphical user composition or an
  # enabled workload asks this front door to cross an unimplemented boundary.
  [[ "$desktop_mode" == headless ]] ||
    die "desktop mode $desktop_mode has no guarded Home apply lifecycle yet"
  [[ "$host_controller" == system-manager || "$host_controller" == not-implemented ]] ||
    die "host desktop controller $host_controller has no guarded apply lifecycle"
  [[ "$isaac_enabled" == false && "$llmster_enabled" == false ]] ||
    die 'an enabled workload has no guarded apply lifecycle yet'
  if [[ "$tailscale_selected" == true &&
    "$tailscale_owner" != migration-pending-apt && "$tailscale_owner" != nix-managed ]]; then
    die "selected Tailscale ownership $tailscale_owner is not applyable"
  fi
  if [[ "$tailscale_selected" == true && "$tailscale_owner" == nix-managed ]]; then
    tailscale_preflight="$("$repo_dir/scripts/dgx-tailscale" plan 2>&1)" ||
      die 'could not inspect declared Nix-managed Tailscale before apply'
    grep -Fq 'PASS|ownership|confirmed-nix-managed;generation=' \
      <<<"$tailscale_preflight" ||
      die 'declared Nix-managed Tailscale does not match the live generation; refusing before mutation'
  fi
  if [[ "$host_controller" == system-manager ]]; then
    [[ -x "$nix_bin" ]] ||
      die 'System Manager desktop convergence requires the declared Nix runtime first'
    desktop_preflight="$("$repo_dir/scripts/dgx-desktop" status 2>&1)" ||
      die 'could not verify the declared System Manager desktop state before apply'
    grep -Fx 'DESKTOP_STATUS=HEADLESS_CONFIRMED' <<<"$desktop_preflight" >/dev/null ||
      die 'declared headless System Manager desktop state is not confirmed; refusing before mutation'
  fi

  printf '# DGX guarded staged apply\n'
  printf '# timestamp_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  emit INFO target "$target_host"
  emit INFO contract 'converge proven Nix/bootstrap and headless Home transactions; verify retained Nix-managed Tailscale and System Manager headless state; leave disabled workloads untouched'
  plan_host "$target_host"

  "$repo_dir/scripts/bootstrap-nix.sh" "$target_host"
  [[ -x "$nix_bin" ]] || die 'Nix bootstrap returned without the required runtime'
  emit PASS apply_nix 'exact bootstrap/runtime transaction converged'

  home_profile=$declared_home/.local/state/nix/profiles/home-manager
  if [[ -L "$home_profile" ]]; then
    home_action=update-headless
  elif [[ ! -e "$home_profile" ]]; then
    home_action=activate-headless
  else
    die "Home Manager profile is a non-symlink: $home_profile"
  fi
  emit INFO home_action "$home_action"
  "$repo_dir/scripts/dgx-home" "$home_action"
  emit PASS apply_home 'exact headless Home transaction converged'

  if [[ "$tailscale_selected" == true ]]; then
    if [[ "$tailscale_owner" == nix-managed ]]; then
      tailscale_status="$("$repo_dir/scripts/dgx-tailscale" status)" ||
        die 'Nix-managed Tailscale failed its exact retained-state verification'
      printf '%s\n' "$tailscale_status"
      grep -Fx 'MIGRATION_STATUS=CONFIRMED_NIX_OWNED' <<<"$tailscale_status" >/dev/null ||
        die 'declared Nix-managed Tailscale is not in the confirmed retained state'
      emit PASS apply_tailscale 'ownership=nix-managed;service, SSH desired state, identity continuity, and current declared generation verified; no restart performed'
    else
      emit HOLD apply_tailscale 'ownership=migration-pending-apt;use scripts/dgx-tailscale for the guarded handoff'
      partial=true
    fi
  fi
  if [[ "$host_controller" == system-manager ]]; then
    desktop_status="$("$repo_dir/scripts/dgx-desktop" status)" ||
      die 'System Manager desktop state failed retained-state verification'
    printf '%s\n' "$desktop_status"
    grep -Fx 'DESKTOP_STATUS=HEADLESS_CONFIRMED' <<<"$desktop_status" >/dev/null ||
      die 'declared headless desktop is not in the confirmed retained state'
    emit PASS apply_desktop 'mode=headless;controller=system-manager;generation five verified; no activation, isolation, or restart performed'
  else
    emit HOLD apply_desktop 'host controller is not implemented; desktop state was not changed'
    partial=true
  fi

  if [[ "$partial" == true ]]; then
    emit PASS apply 'all currently proven layers converged; every unproven role remained untouched'
    printf 'APPLY_STATUS=PARTIAL\n'
  else
    emit PASS apply 'all declared layers converged'
    printf 'APPLY_STATUS=COMPLETE\n'
  fi
}

converge_host() {
  local target_host=$1 actual_host actual_user declared_user declared_home
  local desktop_mode host_controller tailscale_selected tailscale_owner
  local isaac_enabled llmster_enabled current legacy_headless fleet_output fleet_status
  local home_profile home_action

  validate_inputs "$target_host" || die 'fleet/bootstrap input validation failed'
  actual_host="$(hostname -s)"
  actual_user="$(id -un)"
  declared_user="$(json_value "$fleet_file" "hosts.$target_host.users.armen.unixName")"
  declared_home="$(json_value "$fleet_file" "hosts.$target_host.users.armen.homeDirectory")"
  desktop_mode="$(json_value "$fleet_file" "hosts.$target_host.desktop.mode")"
  host_controller="$(json_value "$fleet_file" "hosts.$target_host.desktop.hostController")"
  tailscale_selected="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.selected")"
  tailscale_owner="$(json_value "$fleet_file" "hosts.$target_host.access.tailscale.ownership")"
  isaac_enabled="$(json_value "$fleet_file" "hosts.$target_host.workloads.isaacOmniverse.enabled")"
  llmster_enabled="$(json_value "$fleet_file" "hosts.$target_host.workloads.lmstudioDaemon.enabled")"

  [[ "$target_host" == "$actual_host" ]] ||
    die "converge can target only the local host ($actual_host)"
  [[ "$actual_user" == "$declared_user" && "$HOME" == "$declared_home" ]] ||
    die "converge must run as declared user $declared_user with HOME=$declared_home"
  [[ "$(uname -m)" == aarch64 ]] || die 'converge supports only aarch64 hosts'
  [[ -z "$(git -C "$repo_dir" status --porcelain=v1)" ]] ||
    die 'repository must be clean so converge binds one committed design'
  [[ "$desktop_mode" == headless && "$host_controller" == system-manager ]] ||
    die 'the guarded fresh-host workflow currently supports System Manager headless mode'
  [[ "$isaac_enabled" == false && "$llmster_enabled" == false ]] ||
    die 'enabled workload deployment is not yet part of fresh-host converge'
  if [[ "$tailscale_selected" == true && "$tailscale_owner" != nix-managed ]]; then
    die 'fresh-host converge treats access.tailscale.ownership=nix-managed as the desired state'
  fi

  printf '# DGX resumable fresh-host convergence\n'
  printf '# timestamp_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  emit INFO target "$target_host"
  emit INFO contract 'rerun this same command after disconnects/reboot; it never reboots and never bypasses a rollback guard'

  "$repo_dir/scripts/bootstrap-nix.sh" "$target_host"
  [[ -x "$nix_bin" ]] || die 'Nix bootstrap returned without the required runtime'
  emit PASS converge_nix 'exact bootstrap/runtime transaction converged'

  current="$(readlink -f \
    /nix/var/nix/profiles/system-manager-profiles/system-manager 2>/dev/null || true)"
  legacy_headless="$(cd "$repo_dir" && "$nix_bin" "${nix_args[@]}" \
    eval --raw --no-write-lock-file .#packages.aarch64-linux.root-system-desktop-headless.outPath)"
  if [[ "$target_host" == sparkle-01 && "$current" == "$legacy_headless" ]]; then
    emit INFO root_lifecycle 'recognized retained historical sparkle-01 generation five'
    apply_host "$target_host"
    printf 'CONVERGE_STATUS=COMPLETE\n'
    return
  fi

  if [[ -z "$current" && ! -e /var/lib/dgx-setup/fleet-bootstrap &&
    ! -L /var/lib/dgx-setup/fleet-bootstrap ]]; then
    "$repo_dir/scripts/dgx-fleet-bootstrap" factory
    printf 'CONVERGE_STATUS=FACTORY_TRANSITION_LAUNCHED\n'
    printf 'NEXT_ACTION=reconnect if needed, then rerun ./scripts/dgx-setup converge %s\n' "$target_host"
    return
  fi

  fleet_output="$("$repo_dir/scripts/dgx-fleet-bootstrap" status)" ||
    die 'fresh-host root state could not be classified'
  printf '%s\n' "$fleet_output"
  fleet_status="$(sed -n 's/^FLEET_BOOTSTRAP_STATUS=//p' <<<"$fleet_output" | tail -n 1)"
  case "$fleet_status" in
    AWAITING_TAILSCALE_LOGIN)
      printf 'CONVERGE_STATUS=AWAITING_TAILSCALE_LOGIN\n'
      return
      ;;
    AWAITING_REBOOT)
      printf 'CONVERGE_STATUS=AWAITING_REBOOT\n'
      printf 'NEXT_ACTION=after local recovery is available, separately run sudo systemctl reboot; reconnect and rerun ./scripts/dgx-setup converge %s\n' "$target_host"
      return
      ;;
    AWAITING_FACTORY_CONFIRMATION)
      "$repo_dir/scripts/dgx-fleet-bootstrap" confirm
      emit PASS converge_factory 'first managed generation survived reboot and was confirmed'
      "$repo_dir/scripts/dgx-fleet-bootstrap" headless
      printf 'CONVERGE_STATUS=HEADLESS_TRANSITION_LAUNCHED\n'
      printf 'NEXT_ACTION=reconnect if needed, then rerun ./scripts/dgx-setup converge %s\n' "$target_host"
      return
      ;;
    FACTORY_CONFIRMED)
      "$repo_dir/scripts/dgx-fleet-bootstrap" headless
      printf 'CONVERGE_STATUS=HEADLESS_TRANSITION_LAUNCHED\n'
      printf 'NEXT_ACTION=reconnect if needed, then rerun ./scripts/dgx-setup converge %s\n' "$target_host"
      return
      ;;
    AWAITING_HEADLESS_CONFIRMATION)
      "$repo_dir/scripts/dgx-fleet-bootstrap" confirm
      emit PASS converge_headless 'headless transition verified and confirmed'
      ;;
    HEADLESS_CONFIRMED)
      ;;
    APPLYING | ARMED_WAITING_FOR_WORKER)
      printf 'CONVERGE_STATUS=%s\n' "$fleet_status"
      printf 'NEXT_ACTION=wait for the detached worker, then rerun ./scripts/dgx-setup converge %s\n' "$target_host"
      return
      ;;
    ROLLED_BACK_CLEANUP_PENDING)
      "$repo_dir/scripts/dgx-fleet-bootstrap" cleanup-rolled-back
      printf 'CONVERGE_STATUS=ROLLED_BACK_CLEAN\n'
      printf 'NEXT_ACTION=inspect the recorded snapshot, then rerun ./scripts/dgx-setup converge %s to retry\n' "$target_host"
      return
      ;;
    NOT_STARTED)
      "$repo_dir/scripts/dgx-fleet-bootstrap" factory
      printf 'CONVERGE_STATUS=FACTORY_TRANSITION_LAUNCHED\n'
      return
      ;;
    *) die "unknown fleet bootstrap state: ${fleet_status:-MISSING}" ;;
  esac

  home_profile=$declared_home/.local/state/nix/profiles/home-manager
  if [[ -L "$home_profile" ]]; then
    home_action=update-headless
  elif [[ ! -e "$home_profile" ]]; then
    home_action=activate-headless
  else
    die "Home Manager profile is a non-symlink: $home_profile"
  fi
  emit INFO home_action "$home_action"
  "$repo_dir/scripts/dgx-home" "$home_action"
  emit PASS converge_home 'exact headless Home transaction converged'

  fleet_output="$("$repo_dir/scripts/dgx-fleet-bootstrap" status)" ||
    die 'final fleet root verification failed'
  printf '%s\n' "$fleet_output"
  grep -Fx 'FLEET_BOOTSTRAP_STATUS=HEADLESS_CONFIRMED' <<<"$fleet_output" >/dev/null ||
    die 'final fleet root state is not confirmed headless'
  emit PASS converge 'Nix, root access/desktop, and Home layers match the declaration'
  printf 'CONVERGE_STATUS=COMPLETE\n'
}

[[ "$#" -le 2 ]] || {
  usage
  exit 2
}
case "${1:-}" in
  plan)
    plan_host "${2:-$(hostname -s)}"
    ;;
  bootstrap)
    exec "$repo_dir/scripts/bootstrap-nix.sh" "${2:-$(hostname -s)}"
    ;;
  apply)
    apply_host "${2:-$(hostname -s)}"
    ;;
  converge)
    converge_host "${2:-$(hostname -s)}"
    ;;
  *)
    usage
    exit 2
    ;;
esac
