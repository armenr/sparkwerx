#!/usr/bin/env bash
set -euo pipefail

# One-command, user-scoped Home Manager lifecycle for the minimal headless
# profile. The command itself is the intent signal: there is no brittle
# confirmation phrase. First activation and later generation updates use
# distinct, exact snapshots. A ten-minute user timer restores the prior state
# if the terminal disappears, and successful postflight disarms it
# automatically.

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "$script_dir/../.git" ]]; then
  repo_dir="$(cd -- "$script_dir/.." && pwd)"
else
  repo_dir=""
fi

nix_bin=/nix/var/nix/profiles/default/bin/nix
nix_env=/nix/var/nix/profiles/default/bin/nix-env
nix_store=/nix/var/nix/profiles/default/bin/nix-store
nix_args=(--extra-experimental-features "nix-command flakes")

declare -A context=()
created_snapshot=""

usage() {
  printf '%s\n' \
    "Usage: $(basename "$0") status" \
    "       $(basename "$0") preflight" \
    "       $(basename "$0") activate-headless" \
    "       $(basename "$0") update-headless" \
    "       $(basename "$0") rollback SNAPSHOT_STAMP" \
    "       $(basename "$0") rollback-update SNAPSHOT_STAMP" >&2
}

die() {
  printf 'FAIL|%s\n' "$1" >&2
  exit 1
}

pass() {
  printf 'PASS|%s|%s\n' "$1" "$2"
}

info() {
  printf 'INFO|%s|%s\n' "$1" "$2"
}

warn() {
  printf 'WARN|%s\n' "$1" >&2
}

path_is_absent() {
  [[ ! -e "$1" && ! -L "$1" ]]
}

path_kind() {
  local path=$1
  if [[ -L "$path" ]]; then
    printf 'symlink\n'
  elif [[ -f "$path" ]]; then
    printf 'file\n'
  elif path_is_absent "$path"; then
    printf 'absent\n'
  else
    printf 'unsupported\n'
  fi
}

require_unprivileged() {
  [[ "$EUID" -ne 0 ]] || die 'run this user-profile command without sudo'
  [[ "$(id -u)" -eq 1000 ]] || die 'this pilot currently requires uid 1000'
  [[ -x "$nix_bin" && -x "$nix_env" && -x "$nix_store" ]] ||
    die 'the verified machine-wide Nix 2.35.2 command set is unavailable'
}

require_repository() {
  [[ -n "$repo_dir" ]] || die 'this action must run from the repository copy of dgx-home'
  [[ "$(git -C "$repo_dir" rev-parse --show-toplevel)" == "$repo_dir" ]] ||
    die 'repository root could not be verified'
}

require_clean_repository() {
  [[ -z "$(git -C "$repo_dir" status --porcelain=v1)" ]] ||
    die 'repository must be clean so activation binds one committed design'
}

host_name() {
  hostname -s
}

user_name() {
  id -un
}

home_directory() {
  local passwd_home
  if [[ "${DGX_HOME_TEST_MODE:-}" == 1 ]]; then
    [[ "${DGX_HOME_TEST_HOME:-}" == /tmp/dgx-home-test.*/* ]] ||
      die 'test home must be below an exact /tmp/dgx-home-test.* directory'
    [[ -d "$DGX_HOME_TEST_HOME" && ! -L "$DGX_HOME_TEST_HOME" ]] ||
      die 'test home must be an existing real directory'
    printf '%s\n' "$DGX_HOME_TEST_HOME"
    return
  fi
  passwd_home="$(getent passwd "$(user_name)" | cut -d: -f6)"
  [[ -n "$passwd_home" ]] || die 'could not resolve the current account home'
  [[ "$HOME" == "$passwd_home" ]] ||
    die "HOME is $HOME, expected $passwd_home"
  printf '%s\n' "$passwd_home"
}

activation_attr() {
  printf '.#homeConfigurations."%s@%s".activationPackage\n' \
    "$(user_name)" "$(host_name)"
}

activation_candidate() {
  "$nix_bin" "${nix_args[@]}" eval --raw "$(activation_attr)"
}

profile_manifest_json() {
  "$nix_bin" "${nix_args[@]}" eval --json \
    '.#lib.dgxProfileManifests.aarch64-linux'
}

assert_profile_policy() {
  profile_manifest_json | jq -e '
    ([.roles.fleetBase[].pname] | sort) == ["devbox", "lazydocker", "ncdu"] and
    ([.roles.armenAllModes[].pname] | sort) == ["codex-cli"] and
    ([.evaluatedProfiles.headless[].pname] | sort) ==
      ["codex-cli", "devbox", "hm-session-vars.sh", "lazydocker", "ncdu"] and
    ([.evaluatedProfiles.headless[].pname] |
      map(select(. == "chromium" or . == "ghostty" or . == "hyprland" or
                 . == "lmstudio" or . == "zed-editor"))) == [] and
    (.approvedUnfreePackageNames | sort) == ["lmstudio"]
  ' >/dev/null || die 'headless package manifest differs from the reviewed exact set'

  local systemd_enabled xdg_enabled portal_enabled hm_cli_enabled
  systemd_enabled="$($nix_bin "${nix_args[@]}" eval --json \
    "$(activation_attr | sed 's/\.activationPackage$/.config.systemd.user.enable/')")"
  xdg_enabled="$($nix_bin "${nix_args[@]}" eval --json \
    "$(activation_attr | sed 's/\.activationPackage$/.config.xdg.enable/')")"
  portal_enabled="$($nix_bin "${nix_args[@]}" eval --json \
    "$(activation_attr | sed 's/\.activationPackage$/.config.xdg.portal.enable/')")"
  hm_cli_enabled="$($nix_bin "${nix_args[@]}" eval --json \
    "$(activation_attr | sed 's/\.activationPackage$/.config.programs.home-manager.enable/')")"
  [[ "$systemd_enabled" == false && "$xdg_enabled" == false &&
    "$portal_enabled" == false && "$hm_cli_enabled" == false ]] ||
    die 'headless profile unexpectedly enables user systemd, XDG, a portal, or the Home Manager CLI'
}

assert_headless_candidate_structure() {
  local candidate=$1 home_files
  local -a leaves expected
  [[ "$candidate" == /nix/store/*-home-manager-generation ]] ||
    die 'activation candidate is not an exact Home Manager store output'
  home_files="$(readlink -e "$candidate/home-files" 2>/dev/null || true)"
  [[ -x "$candidate/activate" && -d "$home_files" && -d "$candidate/home-path" ]] ||
    die 'activation candidate is incomplete'
  mapfile -t leaves < <(find "$home_files" \( -type f -o -type l \) -printf '%P\n' | sort)
  expected=(.cache/.keep .local/bin/codex .local/state/.keep)
  [[ "${leaves[*]}" == "${expected[*]}" ]] ||
    die "managed home files differ from the exact three-file boundary: ${leaves[*]}"
  ! grep -q '^_iNote .*reloadSystemd' "$candidate/activate" ||
    die 'headless activation unexpectedly contains Home Manager systemd reload'
}

capture_symlink_inventory() {
  local directory=$1 entry name
  [[ -d "$directory" && ! -L "$directory" ]] ||
    die "symlink inventory directory is invalid: $directory"
  while IFS= read -r entry; do
    [[ -L "$entry" ]] || die "unexpected non-symlink profile entry: $entry"
    name=${entry##*/}
    printf '%s\t%s\n' "$name" "$(readlink -- "$entry")"
  done < <(find "$directory" -mindepth 1 -maxdepth 1 -print | sort)
}

next_profile_generation_link() {
  local directory=$1 prefix=$2 entry name number max=0
  while IFS= read -r entry; do
    name=${entry##*/}
    if [[ "$name" =~ ^${prefix}-([0-9]+)-link$ ]]; then
      number=${BASH_REMATCH[1]}
      ((number > max)) && max=$number
    fi
  done < <(find "$directory" -mindepth 1 -maxdepth 1 -print | sort)
  printf '%s-%s-link\n' "$prefix" "$((max + 1))"
}

assert_no_home_rollback_timer() {
  local active_timers
  active_timers="$({
    systemctl --user list-units --state=active --no-legend --plain \
      'dgx-home-headless-rollback-*.timer' \
      'dgx-home-headless-update-rollback-*.timer' 2>/dev/null || true
  } | sed '/^[[:space:]]*$/d')"
  [[ -z "$active_timers" ]] || die 'a Home rollback timer is already active'
}

assert_root_lane_unchanged() {
  [[ "$(host_name)" == sparkle-01 ]] || return 0

  local attr expected observed
  while IFS=$'\t' read -r attr expected; do
    observed="$($nix_bin "${nix_args[@]}" eval --raw "$attr")"
    [[ "$observed" == "$expected" ]] ||
      die "frozen root lane changed at $attr"
  done <<'EOF'
.#root-system-canary	/nix/store/alrczwil6s2ljh1514css13s79rb5fxj-system-manager
.#root-system-canary-generation-two	/nix/store/pmrqryvdrws80cg988vvm975v1ygv82q-system-manager
.#root-system-canary-generation-three-boot	/nix/store/w8kn2idc0ix6x1024qphv2fvmaf664d7-system-manager
.#root-system-tailscale-migration	/nix/store/vjw778sf95r42a1zbivlk8z4p45y7qhx-system-manager
.#root-system-desktop-headless	/nix/store/djp7ap9gc7kq6c5hhbqzzslvmg4vq3m1-system-manager
.#root-reboot-recovery	/nix/store/wpikhcgj77ws90j4ivdp3498mlmffyax-dgx-root-reboot-recovery
EOF
}

assert_managed_root_state() {
  local host generation_four generation_five fleet_factory fleet_headless current
  local desktop_plan tailscale_plan unit_source unit_tree marker_source canary_source
  local path unit profile_entries
  host="$(host_name)"
  generation_four=/nix/store/vjw778sf95r42a1zbivlk8z4p45y7qhx-system-manager
  generation_five=/nix/store/djp7ap9gc7kq6c5hhbqzzslvmg4vq3m1-system-manager
  fleet_factory="$($nix_bin "${nix_args[@]}" eval --raw --no-write-lock-file \
    ".#lib.dgxFleetRootOutputs.aarch64-linux.\"$host\".factory")" ||
    die 'could not evaluate the fresh-host factory candidate'
  fleet_headless="$($nix_bin "${nix_args[@]}" eval --raw --no-write-lock-file \
    ".#lib.dgxFleetRootOutputs.aarch64-linux.\"$host\".headless")" ||
    die 'could not evaluate the fresh-host headless candidate'
  current="$(readlink -f -- \
    /nix/var/nix/profiles/system-manager-profiles/system-manager 2>/dev/null || true)"

  # A freshly provisioned host reaches the declared root boundary in two
  # generations. sparkle-01's already-live historical five-generation lane is
  # accepted separately below and never rewritten into this newer topology.
  if [[ "$current" == "$fleet_headless" ]]; then
    [[ "$(readlink -- /nix/var/nix/profiles/system-manager-profiles/system-manager)" == \
      system-manager-2-link &&
      "$(readlink -- /nix/var/nix/profiles/system-manager-profiles/system-manager-1-link)" == \
      "$fleet_factory" &&
      "$(readlink -- /nix/var/nix/profiles/system-manager-profiles/system-manager-2-link)" == \
      "$fleet_headless" &&
      "$(readlink -- /nix/var/nix/gcroots/system-manager-current)" == "$fleet_headless" &&
      "$(readlink -- /nix/var/nix/gcroots/dgx-setup-fleet-factory)" == "$fleet_factory" &&
      "$(readlink -- /nix/var/nix/gcroots/dgx-setup-fleet-headless)" == "$fleet_headless" ]] ||
      die 'fresh-host headless profile or retention root changed'
    profile_entries="$(find /nix/var/nix/profiles/system-manager-profiles \
      -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sort)"
    [[ "$profile_entries" == $'system-manager\nsystem-manager-1-link\nsystem-manager-2-link' ]] ||
      die 'fresh-host System Manager generation inventory changed'
    canary_source="$(jq -er '.entries["dgx-setup/canary"].source' \
      "$fleet_headless/etcFiles/etcFiles.json")" ||
      die 'fresh-host canary source is unavailable'
    marker_source="$(jq -er '.entries["dgx-setup/desktop-mode"].source' \
      "$fleet_headless/etcFiles/etcFiles.json")" ||
      die 'fresh-host desktop marker source is unavailable'
    unit_source="$(jq -er '.entries["systemd/system"].source' \
      "$fleet_headless/etcFiles/etcFiles.json")" ||
      die 'fresh-host unit source is unavailable'
    unit_tree="$(readlink -f -- "$unit_source/systemd/system")"
    [[ "$(readlink -f -- /etc/dgx-setup/canary)" == \
      "$(readlink -f -- "$canary_source/dgx-setup/canary")" &&
      "$(readlink -f -- /etc/dgx-setup/desktop-mode)" == \
      "$(readlink -f -- "$marker_source/dgx-setup/desktop-mode")" ]] ||
      die 'fresh-host live markers differ from the candidate'
    while IFS= read -r path; do
      [[ "$(readlink -f -- "/etc/systemd/system/$path")" == \
        "$(readlink -f -- "$unit_tree/$path")" ]] ||
        die "fresh-host live unit path differs from candidate: $path"
    done < <(find -L "$unit_tree" -type f -printf '%P\n' | sort)
    while IFS= read -r unit; do
      [[ "$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null || true)" == \
        "$(jq -er --arg unit "$unit" '.[$unit].storePath' \
          "$fleet_headless/services/services.json")" ]] ||
        die "fresh-host managed service differs from candidate: $unit"
      systemctl is-active --quiet "$unit" ||
        die "fresh-host managed service is inactive: $unit"
    done < <(jq -r 'keys[]' "$fleet_headless/services/services.json")
    for unit in dgx-headless.target system-manager.target dgx-setup-canary.service; do
      systemctl is-active --quiet "$unit" || die "required fresh-host unit is inactive: $unit"
    done
    if grep -Fx 'tailscale-selected=true' /etc/dgx-setup/canary >/dev/null; then
      systemctl is-active --quiet tailscaled.service ||
        die 'selected fresh-host Tailscale service is inactive'
    fi
    for unit in dgx-gnome.target graphical.target gdm.service dgx-dashboard.service; do
      ! systemctl is-active --quiet "$unit" || die "graphical unit is active in fresh-host headless mode: $unit"
    done
    grep -Fx 'lifecycle=fresh-host' /etc/dgx-setup/canary >/dev/null ||
      die 'fresh-host lifecycle marker is incomplete'
    grep -Fx 'desktop-mode=headless' /etc/dgx-setup/canary >/dev/null ||
      die 'fresh-host headless marker is incomplete'
    jq -e '.version == 1 and (.fileTree.backedUpFiles == [])' \
      /var/lib/system-manager/state/system-manager-state.json >/dev/null ||
      die 'fresh-host System Manager state is invalid'
    return 0
  fi

  [[ "$host" == sparkle-01 ]] ||
    die 'root lane is neither the exact declared fresh-host headless generation nor a supported legacy state'

  desktop_plan="$("$repo_dir/scripts/dgx-desktop" plan 2>&1)" ||
    die 'could not inspect the retained headless controller'
  if ! grep -Fx "INFO|live_generation|$generation_five" <<<"$desktop_plan" >/dev/null ||
    ! grep -Fx "INFO|headless_generation|$generation_five" <<<"$desktop_plan" >/dev/null ||
    ! grep -Fx "INFO|candidate_retention|$generation_five" <<<"$desktop_plan" >/dev/null ||
    ! grep -Fx 'INFO|guard|absent' <<<"$desktop_plan" >/dev/null ||
    ! grep -Fx 'INFO|current_default|default.target' <<<"$desktop_plan" >/dev/null; then
    die 'root lane is not exact retained generation-five headless state'
  fi

  tailscale_plan="$("$repo_dir/scripts/dgx-tailscale" plan 2>&1)" ||
    die 'could not inspect retained Nix-managed Tailscale'
  grep -Fx \
    "PASS|ownership|confirmed-nix-managed;generation=$generation_five;inherited-from=$generation_four;desktop=headless" \
    <<<"$tailscale_plan" >/dev/null ||
    die 'generation five does not retain exact Nix-managed Tailscale ownership'

  unit_source="$(jq -er '.entries["systemd/system"].source' \
    "$generation_five/etcFiles/etcFiles.json")" ||
    die 'generation-five unit source is unavailable'
  unit_tree="$(readlink -f -- "$unit_source/systemd/system")"
  marker_source="$(jq -er '.entries["dgx-setup/desktop-mode"].source' \
    "$generation_five/etcFiles/etcFiles.json")" ||
    die 'generation-five desktop marker source is unavailable'
  canary_source="$(jq -er '.entries["dgx-setup/canary"].source' \
    "$generation_five/etcFiles/etcFiles.json")" ||
    die 'generation-five canary source is unavailable'

  [[ "$(readlink -f -- /etc/dgx-setup/desktop-mode)" == \
    "$(readlink -f -- "$marker_source/dgx-setup/desktop-mode")" ]] ||
    die 'live desktop marker differs from generation five'
  [[ "$(readlink -f -- /etc/dgx-setup/canary)" == \
    "$(readlink -f -- "$canary_source/dgx-setup/canary")" ]] ||
    die 'live canary differs from generation five'
  for path in default.target dgx-headless.target dgx-gnome.target; do
    [[ "$(readlink -f -- "/etc/systemd/system/$path")" == \
      "$(readlink -f -- "$unit_tree/$path")" ]] ||
      die "live desktop unit differs from generation five: $path"
  done
  for unit in dgx-setup-canary.service sysinit-reactivation.target \
    system-manager.target tailscaled.service; do
    [[ "$(readlink -f -- "/etc/systemd/system/$unit")" == \
      "$(readlink -f -- "$unit_tree/$unit")" ]] ||
      die "live managed unit differs from generation five: $unit"
    [[ "$(systemctl show "$unit" -p NeedDaemonReload --value 2>/dev/null || true)" == no ]] ||
      die "managed unit needs daemon reload: $unit"
  done
  for unit in dgx-headless.target system-manager.target dgx-setup-canary.service tailscaled.service; do
    systemctl is-active --quiet "$unit" || die "required headless unit is inactive: $unit"
  done
  for unit in dgx-gnome.target graphical.target gdm.service dgx-dashboard.service; do
    ! systemctl is-active --quiet "$unit" || die "graphical unit is active in headless mode: $unit"
  done
  if ! grep -Fx 'desktop-controller-generation=5' /etc/dgx-setup/canary >/dev/null ||
    ! grep -Fx 'desktop-mode=headless' /etc/dgx-setup/canary >/dev/null ||
    ! grep -Fx 'mode=headless' /etc/dgx-setup/desktop-mode >/dev/null; then
    die 'generation-five headless markers are incomplete'
  fi
  jq -e '
    .version == 1 and
    (.fileTree.backedUpFiles == []) and
    ((.fileTree.files | sort) == [
      "/etc/dgx-setup/canary",
      "/etc/dgx-setup/desktop-mode",
      "/etc/systemd/system/default.target",
      "/etc/systemd/system/default.target.wants/system-manager.target",
      "/etc/systemd/system/dgx-gnome.target",
      "/etc/systemd/system/dgx-headless.target",
      "/etc/systemd/system/dgx-setup-canary.service",
      "/etc/systemd/system/sysinit-reactivation.target",
      "/etc/systemd/system/system-manager.target",
      "/etc/systemd/system/system-manager.target.wants/dgx-setup-canary.service",
      "/etc/systemd/system/system-manager.target.wants/tailscaled.service",
      "/etc/systemd/system/tailscaled.service"
    ]) and
    ((.services | keys | sort) == [
      "dgx-setup-canary.service",
      "sysinit-reactivation.target",
      "system-manager.target",
      "tailscaled.service"
    ])
  ' /var/lib/system-manager/state/system-manager-state.json >/dev/null ||
    die 'System Manager state is not exact headless generation five'
}

active_protected_units=(
  docker.service
  dgx-dashboard-admin.service
  nvidia-persistenced.service
)
inactive_protected_units=(
  gdm.service
  dgx-dashboard.service
)

capture_protected_units() {
  local unit load active substate result fragment pid started reload
  local -a observed_active_units=("${active_protected_units[@]}")
  if systemctl is-active --quiet tailscaled.service; then
    observed_active_units=(tailscaled.service "${observed_active_units[@]}")
  fi
  for unit in "${observed_active_units[@]}"; do
    load="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    substate="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
    result="$(systemctl show "$unit" -p Result --value 2>/dev/null || true)"
    fragment="$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null || true)"
    pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
    started="$(systemctl show "$unit" -p ActiveEnterTimestampMonotonic --value 2>/dev/null || true)"
    reload="$(systemctl show "$unit" -p NeedDaemonReload --value 2>/dev/null || true)"
    [[ "$load" == loaded && "$active" == active ]] ||
      die "$unit is not loaded and active"
    [[ "$substate" == running && "$result" == success && -n "$fragment" &&
      "$pid" =~ ^[1-9][0-9]*$ && "$started" =~ ^[1-9][0-9]*$ && "$reload" == no ]] ||
      die "$unit lacks an exact running-process identity"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$unit" "$load" "$active" "$substate" "$fragment" "$pid" "$started" "$reload"
  done
  for unit in "${inactive_protected_units[@]}"; do
    load="$(systemctl show "$unit" -p LoadState --value 2>/dev/null || true)"
    active="$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)"
    substate="$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)"
    result="$(systemctl show "$unit" -p Result --value 2>/dev/null || true)"
    fragment="$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null || true)"
    pid="$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)"
    started="$(systemctl show "$unit" -p ActiveEnterTimestampMonotonic --value 2>/dev/null || true)"
    reload="$(systemctl show "$unit" -p NeedDaemonReload --value 2>/dev/null || true)"
    [[ "$load" == loaded && "$active" == inactive && "$substate" == dead &&
      "$result" == success && -n "$fragment" && "$pid" == 0 && "$reload" == no ]] ||
      die "$unit is not exactly loaded and inactive for headless mode"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$unit" "$load" "$active" "$substate" "$fragment" "$pid" "$started" "$reload"
  done
}

assert_host_health() {
  local state failed tailscale_json tailscale_required=false daemon_path tailscale_client
  state="$(systemctl is-system-running 2>/dev/null || true)"
  [[ "$state" == running ]] || die "systemd state is ${state:-UNKNOWN}"
  failed="$(systemctl --failed --no-legend --plain 2>/dev/null | sed '/^[[:space:]]*$/d' || true)"
  [[ -z "$failed" ]] || die 'systemd reports failed units'
  capture_protected_units >/dev/null

  if grep -Eq '^(tailscale-selected=true|tailscale-migration-generation=)' \
    /etc/dgx-setup/canary 2>/dev/null; then
    tailscale_required=true
  elif [[ -n "$repo_dir" ]] && jq -e --arg host "$(host_name)" \
    '.hosts[$host].access.tailscale.selected == true' \
    "$repo_dir/fleet/hosts.json" >/dev/null 2>&1; then
    tailscale_required=true
  fi

  if [[ "$tailscale_required" == true ]]; then
    daemon_path="$(systemctl show tailscaled.service -p ExecStart --value 2>/dev/null |
      sed -n 's#.*path=\([^ ;}]*\/bin\/tailscaled\).*#\1#p')"
    tailscale_client="${daemon_path%/tailscaled}/tailscale"
    if [[ ! -x "$tailscale_client" ]]; then
      tailscale_client="$(command -v tailscale 2>/dev/null || true)"
    fi
    [[ -x "$tailscale_client" ]] || die 'Tailscale client is unavailable'
    tailscale_json="$("$tailscale_client" status --json 2>/dev/null)" ||
      die 'Tailscale status is unavailable'
    jq -e '
      .BackendState == "Running" and
      .Self.Online == true and
      .CurrentTailnet.MagicDNSSuffix != null
    ' <<<"$tailscale_json" >/dev/null || die 'Tailscale is not running and online'
  fi
}

assert_first_activation_surface() {
  local home candidate home_files user_profiles hm_state launcher config
  home="$(home_directory)"
  candidate=$1
  home_files="$(readlink -e "$candidate/home-files")"
  user_profiles=$home/.local/state/nix/profiles
  hm_state=$home/.local/state/home-manager
  launcher=$home/.local/bin/codex
  config=$home/.codex/config.toml

  assert_headless_candidate_structure "$candidate"

  path_is_absent "$user_profiles/home-manager" ||
    die 'a Home Manager profile already exists; use a future generation-update workflow'
  path_is_absent "$user_profiles/home-manager-1-link" ||
    die 'a Home Manager generation already exists'
  path_is_absent "$hm_state/gcroots/current-home" ||
    die 'a Home Manager current-generation GC root already exists'

  [[ -d "$user_profiles" ]] || die 'Nix user profile directory is absent'
  [[ -L "$home/.nix-profile" ]] || die 'the home Nix profile is not the expected installer symlink'
  [[ "$(readlink -- "$home/.nix-profile")" == "$user_profiles/profile" ]] ||
    die 'the home Nix profile points outside the expected XDG profile directory'
  path_is_absent "$user_profiles/profile" ||
    die 'the first-activation pilot requires an empty user Nix profile'
  path_is_absent "$user_profiles/profile-1-link" ||
    die 'the first-activation pilot found prior user profile history'

  path_is_absent "$home/.cache/.keep" || die 'the home cache marker collides with Home Manager'
  path_is_absent "$home/.local/state/.keep" || die 'the home state marker collides with Home Manager'
  path_is_absent "$home/.config/environment.d/10-home-manager.conf" ||
    die 'headless-forbidden Home Manager environment.d file already exists'
  path_is_absent "$home/.config/systemd/user/tray.target" ||
    die 'headless-forbidden Home Manager tray.target already exists'

  case "$(path_kind "$launcher")" in
    absent | symlink | file) ;;
    *) die 'the existing Codex launcher has an unsupported file type' ;;
  esac
  [[ ! -e "$home/.local/bin" || ( -d "$home/.local/bin" && -O "$home/.local/bin" ) ]] ||
    die 'the home local-bin path is not an owned directory'

  case "$(path_kind "$config")" in
    absent) ;;
    file)
      [[ -O "$config" ]] || die 'Codex config is not owned by the current user'
      ;;
    *) die 'Codex config must be absent or an owned regular file' ;;
  esac
  [[ ! -e "$home/.codex" || ( -d "$home/.codex" && -O "$home/.codex" && ! -L "$home/.codex" ) ]] ||
    die 'the Codex state path is not an owned, real directory'
}

run_preflight() {
  require_unprivileged
  require_repository
  require_clean_repository

  local candidate dry_run
  candidate="$(activation_candidate)"
  info candidate "$candidate"
  "$nix_bin" "${nix_args[@]}" build --no-link \
    "$(activation_attr)" \
    '.#checks.aarch64-linux.profile-policy' \
    '.#checks.aarch64-linux.codex-cli-policy' \
    '.#checks.aarch64-linux.devbox-policy'
  assert_profile_policy
  assert_root_lane_unchanged
  assert_managed_root_state
  assert_host_health
  assert_first_activation_surface "$candidate"

  dry_run="$(DRY_RUN=1 VERBOSE=1 "$candidate/activate" 2>&1)" || {
    printf '%s\n' "$dry_run" >&2
    die 'Home Manager dry run failed'
  }
  grep -F 'Skipping collision check for ' <<<"$dry_run" | grep -F '/.local/bin/codex' >/dev/null ||
    die 'dry run did not recognize the intentional Codex launcher takeover'
  grep -F "Would reconcile Armen's non-secret Codex permission defaults" <<<"$dry_run" >/dev/null ||
    die 'dry run did not keep Codex reconciliation non-mutating'
  ! grep -F 'Activating reloadSystemd' <<<"$dry_run" >/dev/null ||
    die 'dry run contains a user-systemd activation phase'

  pass preflight 'exact first headless Home profile is built, collision-clean, and non-mutating in dry-run'
}

record_path_backup() {
  local path=$1 label=$2 destination=$3 kind
  kind="$(path_kind "$path")"
  printf '%s\t%s\n' "${label}_kind" "$kind" >>"$destination/context.tsv"
  case "$kind" in
    symlink)
      printf '%s\t%s\n' "${label}_link" "$(readlink -- "$path")" >>"$destination/context.tsv"
      ;;
    file)
      cp -p -- "$path" "$destination/backup/$label"
      printf '%s\t%s\n' "${label}_mode" "$(stat -c %a -- "$path")" >>"$destination/context.tsv"
      ;;
    absent) ;;
    *) die "cannot snapshot unsupported path: $path" ;;
  esac
}

create_snapshot() {
  local candidate=$1 home host user stamp destination home_path home_files unit
  home="$(home_directory)"
  host="$(host_name)"
  user="$(user_name)"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  destination=$repo_dir/inventory/$host/private/home-manager-headless/$stamp
  home_path="$(readlink -e "$candidate/home-path")"
  home_files="$(readlink -e "$candidate/home-files")"
  unit="dgx-home-headless-rollback-${stamp,,}"

  umask 077
  mkdir -p -- "$destination/backup"
  chmod 0700 -- "$destination"
  : >"$destination/context.tsv"
  printf '%s\t%s\n' \
    format 1 \
    snapshot "$destination" \
    stamp "$stamp" \
    host "$host" \
    user "$user" \
    home "$home" \
    repo "$repo_dir" \
    repo_commit "$(git -C "$repo_dir" rev-parse HEAD)" \
    candidate "$candidate" \
    home_path "$home_path" \
    home_files "$home_files" \
    timer_unit "$unit" \
    user_groups "$(id -G)" \
    >"$destination/context.tsv"

  record_path_backup "$home/.local/bin/codex" launcher "$destination"
  record_path_backup "$home/.codex/config.toml" codex_config "$destination"
  capture_protected_units >"$destination/protected-units.before.tsv"

  if [[ -f "$home/.codex/config.toml" ]]; then
    cp -p -- "$home/.codex/config.toml" "$destination/codex-config.expected"
  else
    install -m 0600 /dev/null "$destination/codex-config.expected"
  fi
  "$repo_dir/scripts/reconcile-codex-relaxed-defaults.sh" \
    --apply "$destination/codex-config.expected" >/dev/null
  printf '%s\t%s\n' expected_codex_config_sha256 \
    "$(sha256sum "$destination/codex-config.expected" | awk '{print $1}')" \
    >>"$destination/context.tsv"

  cp -p -- "$repo_dir/scripts/dgx-home" "$destination/dgx-home"
  chmod 0700 -- "$destination/dgx-home"
  printf 'Snapshot creation completed.\n' >"$destination/SNAPSHOT_COMPLETE"
  (
    cd "$destination"
    find . -type f ! -name SHA256SUMS ! -name RETAINED ! -name ROLLED_BACK \
      -print0 | sort -z | xargs -0 sha256sum
  ) >"$destination/SHA256SUMS"

  created_snapshot=$destination
}

create_update_snapshot() {
  local old_candidate=$1 candidate=$2
  local home host user stamp destination profiles gcroots unit
  local old_home_path old_home_files old_user_environment home_path home_files
  local old_hm_selected old_profile_selected new_hm_generation new_profile_generation
  local expected_user_environment
  home="$(home_directory)"
  host="$(host_name)"
  user="$(user_name)"
  profiles=$home/.local/state/nix/profiles
  gcroots=$home/.local/state/home-manager/gcroots
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  destination=$repo_dir/inventory/$host/private/home-manager-headless-update/$stamp
  unit="dgx-home-headless-update-rollback-${stamp,,}"

  old_home_path="$(readlink -e "$old_candidate/home-path")"
  old_home_files="$(readlink -e "$old_candidate/home-files")"
  old_user_environment="$(readlink -e "$profiles/profile")"
  home_path="$(readlink -e "$candidate/home-path")"
  home_files="$(readlink -e "$candidate/home-files")"
  old_hm_selected="$(readlink -- "$profiles/home-manager")"
  old_profile_selected="$(readlink -- "$profiles/profile")"
  new_hm_generation="$(next_profile_generation_link "$profiles" home-manager)"
  new_profile_generation="$(next_profile_generation_link "$profiles" profile)"

  [[ "$old_candidate" != "$candidate" ]] ||
    die 'generation-update snapshot requires a distinct candidate'
  [[ "$old_hm_selected" =~ ^home-manager-[0-9]+-link$ &&
    "$old_profile_selected" =~ ^profile-[0-9]+-link$ ]] ||
    die 'current generation selection names are invalid'
  path_is_absent "$profiles/$new_hm_generation" ||
    die 'computed next Home Manager generation already exists'
  path_is_absent "$profiles/$new_profile_generation" ||
    die 'computed next user-profile generation already exists'

  umask 077
  mkdir -p -- "$destination/backup"
  chmod 0700 -- "$destination"
  capture_symlink_inventory "$profiles" >"$destination/profiles.before.tsv"
  capture_symlink_inventory "$gcroots" >"$destination/gcroots.before.tsv"
  cp -p -- "$home/.codex/config.toml" "$destination/backup/codex_config"
  cp -p -- "$home/.codex/config.toml" "$destination/codex-config.expected"
  "$repo_dir/scripts/reconcile-codex-relaxed-defaults.sh" \
    --apply "$destination/codex-config.expected" >/dev/null
  capture_protected_units >"$destination/protected-units.before.tsv"

  "$nix_store" --realise "$candidate" \
    --add-root "$destination/candidate-root" >/dev/null
  "$nix_env" --profile "$destination/expected-profile" -i "$home_path" >/dev/null
  expected_user_environment="$(readlink -e "$destination/expected-profile")"

  printf '%s\t%s\n' \
    format 2 \
    kind headless-update \
    snapshot "$destination" \
    stamp "$stamp" \
    host "$host" \
    user "$user" \
    home "$home" \
    repo "$repo_dir" \
    repo_commit "$(git -C "$repo_dir" rev-parse HEAD)" \
    old_candidate "$old_candidate" \
    old_home_path "$old_home_path" \
    old_home_files "$old_home_files" \
    old_user_environment "$old_user_environment" \
    old_home_manager_selected "$old_hm_selected" \
    old_profile_selected "$old_profile_selected" \
    candidate "$candidate" \
    home_path "$home_path" \
    home_files "$home_files" \
    expected_user_environment "$expected_user_environment" \
    new_home_manager_generation "$new_hm_generation" \
    new_profile_generation "$new_profile_generation" \
    expected_codex_config_sha256 "$(sha256sum "$destination/codex-config.expected" | awk '{print $1}')" \
    timer_unit "$unit" \
    user_groups "$(id -G)" \
    >"$destination/context.tsv"

  cp -p -- "$repo_dir/scripts/dgx-home" "$destination/dgx-home"
  chmod 0700 -- "$destination/dgx-home"
  printf 'Snapshot creation completed.\n' >"$destination/SNAPSHOT_COMPLETE"
  (
    cd "$destination"
    find . -type f ! -name SHA256SUMS ! -name RETAINED ! -name ROLLED_BACK \
      -print0 | sort -z | xargs -0 sha256sum
  ) >"$destination/SHA256SUMS"

  created_snapshot=$destination
}

load_snapshot() {
  local snapshot=$1 key value mode owner
  [[ "$snapshot" == /* && -d "$snapshot" && ! -L "$snapshot" ]] ||
    die 'snapshot must be an existing absolute real directory'
  mode="$(stat -c %a -- "$snapshot")"
  owner="$(stat -c %U -- "$snapshot")"
  [[ "$mode" == 700 && "$owner" == "$(user_name)" ]] ||
    die 'snapshot must be mode 0700 and owned by the current user'
  [[ "$(cat "$snapshot/SNAPSHOT_COMPLETE")" == 'Snapshot creation completed.' ]] ||
    die 'snapshot completion marker is absent'
  (
    cd "$snapshot"
    sha256sum -c SHA256SUMS >/dev/null
  ) || die 'snapshot checksum verification failed'

  context=()
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" && -z "${context[$key]+set}" ]] ||
      die 'snapshot context has an empty or duplicate key'
    context[$key]=$value
  done <"$snapshot/context.tsv"

  [[ "${context[format]-}" == 1 || "${context[format]-}" == 2 ]] ||
    die 'snapshot format is unsupported'
  [[ "${context[snapshot]-}" == "$snapshot" ]] || die 'snapshot path differs from its context'
  [[ "${context[host]-}" == "$(host_name)" ]] || die 'snapshot host differs from this host'
  [[ "${context[user]-}" == "$(user_name)" ]] || die 'snapshot user differs from this user'
  [[ "${context[home]-}" == "$(home_directory)" ]] || die 'snapshot home differs from this account'
  [[ "${context[candidate]-}" == /nix/store/*-home-manager-generation ]] ||
    die 'snapshot candidate is not a Home Manager generation'
  [[ "${context[home_path]-}" == /nix/store/*-home-manager-path ]] ||
    die 'snapshot home path is invalid'
  [[ "${context[home_files]-}" == /nix/store/*-home-manager-files ]] ||
    die 'snapshot home-files path is invalid'

  if [[ "${context[format]}" == 2 ]]; then
    [[ "${context[kind]-}" == headless-update ]] ||
      die 'generation-update snapshot kind is invalid'
    [[ "${context[old_candidate]-}" == /nix/store/*-home-manager-generation ]] ||
      die 'old Home Manager candidate is invalid'
    [[ "${context[old_home_path]-}" == /nix/store/*-home-manager-path ]] ||
      die 'old Home Manager path is invalid'
    [[ "${context[old_home_files]-}" == /nix/store/*-home-manager-files ]] ||
      die 'old Home Manager files path is invalid'
    [[ "${context[old_user_environment]-}" == /nix/store/*-user-environment ]] ||
      die 'old user environment is invalid'
    [[ "${context[expected_user_environment]-}" == /nix/store/*-user-environment ]] ||
      die 'expected user environment is invalid'
    [[ "${context[old_home_manager_selected]-}" =~ ^home-manager-[0-9]+-link$ ]] ||
      die 'old Home Manager selected link is invalid'
    [[ "${context[new_home_manager_generation]-}" =~ ^home-manager-[0-9]+-link$ ]] ||
      die 'new Home Manager generation link is invalid'
    [[ "${context[old_profile_selected]-}" =~ ^profile-[0-9]+-link$ ]] ||
      die 'old user-profile selected link is invalid'
    [[ "${context[new_profile_generation]-}" =~ ^profile-[0-9]+-link$ ]] ||
      die 'new user-profile generation link is invalid'
    [[ -r "$snapshot/profiles.before.tsv" && -r "$snapshot/gcroots.before.tsv" ]] ||
      die 'generation-update symlink inventories are absent'
    [[ -L "$snapshot/candidate-root" &&
      "$(readlink -e "$snapshot/candidate-root")" == "${context[candidate]}" ]] ||
      die 'generation-update candidate retention is not exact'
    [[ -L "$snapshot/expected-profile" &&
      "$(readlink -e "$snapshot/expected-profile")" == "${context[expected_user_environment]}" ]] ||
      die 'expected user-environment retention is not exact'
  fi
}

assert_profile_contains_only_home_path() {
  local profile=$1 expected_path=$2 listing
  listing="$($nix_env --profile "$profile" -q --out-path 2>/dev/null | awk '{$1=$1; print}' || true)"
  [[ "$listing" == "home-manager-path $expected_path" ]] ||
    die "user profile is not the exact Home Manager path: ${listing:-EMPTY}"
}

assert_managed_link() {
  local path=$1 expected_path=$2
  [[ -L "$path" && "$(readlink -- "$path")" == "$expected_path" ]] ||
    die "$path is not the exact Home Manager link"
}

assert_exact_headless_live() {
  local candidate=$1 home_path=$2 home_files=$3 user_environment=$4
  local expected_hm_selected=$5 expected_profile_selected=$6
  local home profiles hm_state command expected_command
  home="$(home_directory)"
  profiles=$home/.local/state/nix/profiles
  hm_state=$home/.local/state/home-manager

  assert_headless_candidate_structure "$candidate"
  [[ -L "$profiles/home-manager" &&
    "$(readlink -- "$profiles/home-manager")" == "$expected_hm_selected" ]] ||
    die 'selected Home Manager generation link is not exact'
  [[ -L "$profiles/$expected_hm_selected" &&
    "$(readlink -e "$profiles/$expected_hm_selected")" == "$candidate" ]] ||
    die 'selected Home Manager generation does not resolve to the expected candidate'
  [[ -L "$hm_state/gcroots/current-home" &&
    "$(readlink -e "$hm_state/gcroots/current-home")" == "$candidate" ]] ||
    die 'Home Manager current-generation root is not exact'

  [[ -L "$profiles/profile" &&
    "$(readlink -- "$profiles/profile")" == "$expected_profile_selected" ]] ||
    die 'selected user-profile generation link is not exact'
  [[ -L "$profiles/$expected_profile_selected" &&
    "$(readlink -e "$profiles/$expected_profile_selected")" == "$user_environment" ]] ||
    die 'selected user-profile generation does not resolve to the expected environment'
  assert_profile_contains_only_home_path "$profiles/profile" "$home_path"

  assert_managed_link "$home/.local/bin/codex" "$home_files/.local/bin/codex"
  assert_managed_link "$home/.cache/.keep" "$home_files/.cache/.keep"
  assert_managed_link "$home/.local/state/.keep" "$home_files/.local/state/.keep"
  path_is_absent "$home/.config/environment.d/10-home-manager.conf" ||
    die 'headless profile contains an environment.d file'
  path_is_absent "$home/.config/systemd/user/tray.target" ||
    die 'headless profile contains tray.target'

  [[ -f "$home/.codex/config.toml" && ! -L "$home/.codex/config.toml" &&
    -O "$home/.codex/config.toml" ]] ||
    die 'Codex config is not an owned regular mutable file'
  for command in codex ncdu lazydocker devbox; do
    expected_command=$home_path/bin/$command
    [[ -x "$home/.nix-profile/bin/$command" && -x "$expected_command" &&
      "$(readlink -e "$home/.nix-profile/bin/$command")" == "$(readlink -e "$expected_command")" ]] ||
      die "$command does not resolve through the exact Home Manager path"
  done
  [[ "$(readlink -e "$home/.local/bin/codex")" == "$(readlink -e "$home_path/bin/codex")" ]] ||
    die 'the high-precedence Codex launcher does not match the profile package'
  for command in chromium ghostty home-manager lmstudio zed; do
    path_is_absent "$home/.nix-profile/bin/$command" ||
      die "forbidden headless launcher entered the profile: $command"
  done
}

smoke_current_manifest_versions() {
  local home manifest codex_version ncdu_version lazydocker_version devbox_version
  home="$(home_directory)"
  manifest="$(profile_manifest_json)"
  codex_version="$(jq -er '.roles.armenAllModes[] | select(.pname == "codex-cli") | .version' <<<"$manifest")"
  ncdu_version="$(jq -er '.roles.fleetBase[] | select(.pname == "ncdu") | .version' <<<"$manifest")"
  lazydocker_version="$(jq -er '.roles.fleetBase[] | select(.pname == "lazydocker") | .version' <<<"$manifest")"
  devbox_version="$(jq -er '.roles.fleetBase[] | select(.pname == "devbox") | .version' <<<"$manifest")"

  [[ "$("$home/.local/bin/codex" --version 2>/dev/null)" == "codex-cli $codex_version" ]] ||
    die "Codex $codex_version smoke test failed"
  "$home/.nix-profile/bin/ncdu" --version | grep -Fx "ncdu $ncdu_version" >/dev/null ||
    die "ncdu $ncdu_version smoke test failed"
  "$home/.nix-profile/bin/lazydocker" --version | grep -F "Version: $lazydocker_version" >/dev/null ||
    die "lazydocker $lazydocker_version smoke test failed"
  [[ "$("$home/.nix-profile/bin/devbox" version)" == "$devbox_version" ]] ||
    die "Devbox $devbox_version smoke test failed"
}

assert_current_headless_live() {
  local candidate="$1" home profiles home_path home_files user_environment
  local hm_selected profile_selected
  home="$(home_directory)"
  profiles=$home/.local/state/nix/profiles

  [[ "$candidate" == /nix/store/*-home-manager-generation ]] ||
    die 'live Home Manager candidate is not an exact store generation'
  home_path="$(readlink -e "$candidate/home-path" 2>/dev/null || true)"
  home_files="$(readlink -e "$candidate/home-files" 2>/dev/null || true)"
  user_environment="$(readlink -e "$profiles/profile" 2>/dev/null || true)"
  hm_selected="$(readlink -- "$profiles/home-manager" 2>/dev/null || true)"
  profile_selected="$(readlink -- "$profiles/profile" 2>/dev/null || true)"
  [[ "$home_path" == /nix/store/*-home-manager-path &&
    "$home_files" == /nix/store/*-home-manager-files &&
    "$user_environment" == /nix/store/*-user-environment ]] ||
    die 'live Home Manager generation has incomplete resolved outputs'
  [[ "$hm_selected" =~ ^home-manager-[0-9]+-link$ &&
    "$profile_selected" =~ ^profile-[0-9]+-link$ ]] ||
    die 'selected Home generation names are invalid'
  capture_symlink_inventory "$profiles" >/dev/null
  capture_symlink_inventory "$home/.local/state/home-manager/gcroots" >/dev/null
  assert_exact_headless_live "$candidate" "$home_path" "$home_files" \
    "$user_environment" "$hm_selected" "$profile_selected"
  assert_no_home_rollback_timer
}

run_postflight() {
  local snapshot=$1 home candidate home_path home_files profiles current_units
  local current_config_sha
  load_snapshot "$snapshot"
  home=${context[home]}
  candidate=${context[candidate]}
  home_path=${context[home_path]}
  home_files=${context[home_files]}
  profiles=$home/.local/state/nix/profiles

  [[ -L "$profiles/home-manager" && "$(readlink -- "$profiles/home-manager")" == home-manager-1-link ]] ||
    die 'Home Manager selected profile is not generation one'
  [[ -L "$profiles/home-manager-1-link" && "$(readlink -e "$profiles/home-manager-1-link")" == "$candidate" ]] ||
    die 'Home Manager generation one does not point to the exact candidate'
  [[ -L "$home/.local/state/home-manager/gcroots/current-home" &&
    "$(readlink -e "$home/.local/state/home-manager/gcroots/current-home")" == "$candidate" ]] ||
    die 'Home Manager current-generation root is not exact'

  [[ -L "$profiles/profile" && "$(readlink -- "$profiles/profile")" == profile-1-link ]] ||
    die 'user Nix profile is not exact generation one'
  [[ -L "$profiles/profile-1-link" ]] || die 'user Nix profile generation one is absent'
  assert_profile_contains_only_home_path "$profiles/profile" "$home_path"

  assert_managed_link "$home/.local/bin/codex" "$home_files/.local/bin/codex"
  assert_managed_link "$home/.cache/.keep" "$home_files/.cache/.keep"
  assert_managed_link "$home/.local/state/.keep" "$home_files/.local/state/.keep"
  path_is_absent "$home/.config/environment.d/10-home-manager.conf" ||
    die 'headless activation created an environment.d file'
  path_is_absent "$home/.config/systemd/user/tray.target" ||
    die 'headless activation created tray.target'

  current_config_sha="$(sha256sum "$home/.codex/config.toml" | awk '{print $1}')"
  [[ "$current_config_sha" == "${context[expected_codex_config_sha256]}" ]] ||
    die 'Codex config does not match the snapshot-derived permission policy'
  "$repo_dir/scripts/reconcile-codex-relaxed-defaults.sh" \
    --check "$home/.codex/config.toml" >/dev/null || die 'Codex permission policy check failed'

  smoke_current_manifest_versions
  for forbidden in chromium ghostty home-manager lmstudio zed; do
    path_is_absent "$home/.nix-profile/bin/$forbidden" ||
      die "forbidden headless launcher entered the profile: $forbidden"
  done
  [[ "$(id -G)" == "${context[user_groups]}" ]] ||
    die 'account group membership changed during Home activation'

  current_units="$(capture_protected_units)"
  [[ "$current_units" == "$(cat "$snapshot/protected-units.before.tsv")" ]] ||
    die 'a protected factory/access service restarted during Home activation'
  assert_host_health
  assert_managed_root_state
  pass postflight 'exact four-package headless generation one is active; root, services, and graphical boundary are unchanged'
}

timer_is_active() {
  systemctl --user is-active --quiet "$1.timer"
}

disarm_timer() {
  local unit=$1
  systemctl --user stop "$unit.timer" >/dev/null 2>&1 || true
  ! timer_is_active "$unit" || die "rollback timer $unit.timer could not be stopped"
}

arm_timer() {
  local snapshot=$1 unit=${context[timer_unit]}
  ! timer_is_active "$unit" || die "rollback timer $unit.timer is already active"
  systemd-run --user --quiet --collect \
    --unit="$unit" \
    --on-active=10m \
    --timer-property=AccuracySec=1s \
    /bin/bash "$snapshot/dgx-home" rollback-snapshot "$snapshot"
  timer_is_active "$unit" || die 'automatic Home rollback timer did not arm'
  pass rollback "$unit.timer is active for ten minutes"
}

arm_update_timer() {
  local snapshot=$1 unit=${context[timer_unit]}
  ! timer_is_active "$unit" || die "rollback timer $unit.timer is already active"
  systemd-run --user --quiet --collect \
    --unit="$unit" \
    --on-active=10m \
    --timer-property=AccuracySec=1s \
    /bin/bash "$snapshot/dgx-home" rollback-update-snapshot "$snapshot"
  timer_is_active "$unit" || die 'automatic Home update rollback timer did not arm'
  pass rollback "$unit.timer is active for ten minutes"
}

pre_path_matches() {
  local path=$1 label=$2 snapshot=$3 kind
  local actual_sha backup_sha
  kind=${context[${label}_kind]}
  case "$kind" in
    absent)
      path_is_absent "$path"
      ;;
    symlink)
      [[ -L "$path" && "$(readlink -- "$path")" == "${context[${label}_link]}" ]]
      ;;
    file)
      [[ -f "$path" && ! -L "$path" ]] || return 1
      actual_sha="$(sha256sum "$path" | awk '{print $1}')"
      backup_sha="$(sha256sum "$snapshot/backup/$label" | awk '{print $1}')"
      [[ "$actual_sha" == "$backup_sha" ]]
      ;;
    *) return 1 ;;
  esac
}

restore_pre_path() {
  local path=$1 label=$2 snapshot=$3 kind
  kind=${context[${label}_kind]}
  path_is_absent "$path" || die "refusing to overwrite non-empty rollback target $path"
  case "$kind" in
    absent) ;;
    symlink)
      ln -s -- "${context[${label}_link]}" "$path"
      ;;
    file)
      cp -p -- "$snapshot/backup/$label" "$path"
      ;;
    *) die "unsupported rollback kind for $label" ;;
  esac
}

validate_rollback_surface() {
  local home candidate home_path home_files profiles path expected
  home=${context[home]}
  candidate=${context[candidate]}
  home_path=${context[home_path]}
  home_files=${context[home_files]}
  profiles=$home/.local/state/nix/profiles

  for pair in \
    "$home/.cache/.keep|$home_files/.cache/.keep" \
    "$home/.local/state/.keep|$home_files/.local/state/.keep"; do
    path=${pair%%|*}
    expected=${pair#*|}
    if ! path_is_absent "$path"; then
      [[ -L "$path" && "$(readlink -- "$path")" == "$expected" ]] ||
        die "rollback refuses drifted managed path $path"
    fi
  done

  path=$home/.local/bin/codex
  if ! pre_path_matches "$path" launcher "${context[snapshot]}"; then
    [[ -L "$path" && "$(readlink -- "$path")" == "$home_files/.local/bin/codex" ]] ||
      die 'rollback refuses a Codex launcher changed after activation'
  fi

  if ! path_is_absent "$profiles/home-manager"; then
    [[ -L "$profiles/home-manager" && "$(readlink -- "$profiles/home-manager")" == home-manager-1-link ]] ||
      die 'rollback refuses a changed Home Manager selected profile'
  fi
  if ! path_is_absent "$profiles/home-manager-1-link"; then
    [[ -L "$profiles/home-manager-1-link" &&
      "$(readlink -e "$profiles/home-manager-1-link")" == "$candidate" ]] ||
      die 'rollback refuses a changed Home Manager generation one'
  fi
  if ! path_is_absent "$home/.local/state/home-manager/gcroots/current-home"; then
    [[ -L "$home/.local/state/home-manager/gcroots/current-home" &&
      "$(readlink -e "$home/.local/state/home-manager/gcroots/current-home")" == "$candidate" ]] ||
      die 'rollback refuses a changed Home Manager GC root'
  fi
  if ! path_is_absent "$profiles/profile"; then
    [[ -L "$profiles/profile" && "$(readlink -- "$profiles/profile")" == profile-1-link ]] ||
      die 'rollback refuses a changed user Nix profile'
    [[ -L "$profiles/profile-1-link" ]] || die 'user profile generation one is missing'
    assert_profile_contains_only_home_path "$profiles/profile" "$home_path"
  elif ! path_is_absent "$profiles/profile-1-link"; then
    [[ -L "$profiles/profile-1-link" ]] ||
      die 'rollback refuses a non-symlinked user profile generation one'
    assert_profile_contains_only_home_path "$profiles/profile-1-link" "$home_path"
  fi
}

unlink_if_present() {
  local path=$1
  path_is_absent "$path" || unlink -- "$path"
}

rollback_snapshot() {
  local snapshot=$1 home home_files profiles unit config current_config_sha expected_sha
  local config_drift=false
  require_unprivileged
  load_snapshot "$snapshot"
  home=${context[home]}
  home_files=${context[home_files]}
  profiles=$home/.local/state/nix/profiles
  unit=${context[timer_unit]}
  config=$home/.codex/config.toml
  expected_sha=${context[expected_codex_config_sha256]}
  validate_rollback_surface

  disarm_timer "$unit"
  for path in "$home/.cache/.keep" "$home/.local/state/.keep"; do
    if [[ -L "$path" ]]; then
      unlink -- "$path"
    fi
  done
  if ! pre_path_matches "$home/.local/bin/codex" launcher "$snapshot"; then
    unlink_if_present "$home/.local/bin/codex"
    restore_pre_path "$home/.local/bin/codex" launcher "$snapshot"
  fi

  if [[ -f "$config" && ! -L "$config" ]]; then
    current_config_sha="$(sha256sum "$config" | awk '{print $1}')"
  else
    current_config_sha=NON_FILE
  fi
  if ! pre_path_matches "$config" codex_config "$snapshot"; then
    if [[ "$current_config_sha" == "$expected_sha" ]]; then
      unlink_if_present "$config"
      restore_pre_path "$config" codex_config "$snapshot"
    else
      config_drift=true
      warn 'Codex config changed after activation; preserving the newer file instead of overwriting it'
    fi
  fi

  unlink_if_present "$profiles/profile"
  unlink_if_present "$profiles/profile-1-link"
  unlink_if_present "$profiles/home-manager"
  unlink_if_present "$profiles/home-manager-1-link"
  unlink_if_present "$home/.local/state/home-manager/gcroots/new-home"
  unlink_if_present "$home/.local/state/home-manager/gcroots/current-home"
  rmdir -- "$home/.local/state/home-manager/gcroots" 2>/dev/null || true
  rmdir -- "$home/.local/state/home-manager" 2>/dev/null || true

  path_is_absent "$profiles/profile" || die 'user Nix profile rollback is incomplete'
  path_is_absent "$profiles/home-manager" || die 'Home Manager profile rollback is incomplete'
  path_is_absent "$home/.cache/.keep" || die 'managed cache marker rollback is incomplete'
  path_is_absent "$home/.local/state/.keep" || die 'managed state marker rollback is incomplete'
  pre_path_matches "$home/.local/bin/codex" launcher "$snapshot" ||
    die 'Codex launcher rollback is incomplete'
  if [[ "$config_drift" == false ]]; then
    pre_path_matches "$config" codex_config "$snapshot" ||
      die 'Codex config rollback is incomplete'
  fi
  assert_host_health
  printf 'Rollback completed.\n' >"$snapshot/ROLLED_BACK"
  pass rollback 'exact pre-Home profile and launcher state restored; snapshot retained'
}

assert_inventory_transition() {
  local inventory=$1 directory=$2 selection=$3 old_selection=$4
  local new_generation=$5 new_target=$6 phase=$7
  local peer_new_generation=$8 peer_new_target=$9
  local peer_selection=${10} peer_old_selection=${11}
  local name target entry saw_new=false
  local -A before=()

  while IFS=$'\t' read -r name target; do
    [[ -n "$name" && -z "${before[$name]+set}" ]] ||
      die "invalid or duplicate entry in $inventory"
    before[$name]=$target
  done <"$inventory"
  [[ "${before[$selection]-}" == "$old_selection" ]] ||
    die "$selection pre-state differs from its snapshot"
  [[ -z "${before[$new_generation]+set}" ]] ||
    die "$new_generation unexpectedly existed before the update"

  while IFS= read -r entry; do
    [[ -L "$entry" ]] || die "unexpected non-symlink profile entry: $entry"
    name=${entry##*/}
    target="$(readlink -- "$entry")"
    if [[ "$name" == "$selection" ]]; then
      if [[ "$phase" == complete ]]; then
        [[ "$target" == "$new_generation" ]] ||
          die "$selection does not select the new generation"
      else
        [[ "$target" == "$old_selection" || "$target" == "$new_generation" ]] ||
          die "$selection points outside the old/new update boundary"
      fi
    elif [[ "$name" == "$peer_selection" ]]; then
      if [[ "$phase" == complete ]]; then
        [[ "$target" == "$peer_new_generation" ]] ||
          die "$peer_selection does not select the new generation"
      else
        [[ "$target" == "$peer_old_selection" || "$target" == "$peer_new_generation" ]] ||
          die "$peer_selection points outside the old/new update boundary"
      fi
    elif [[ "$name" == "$new_generation" ]]; then
      [[ "$target" == "$new_target" ]] ||
        die "$new_generation does not point to the exact candidate"
      saw_new=true
    elif [[ "$name" == "$peer_new_generation" ]]; then
      [[ "$target" == "$peer_new_target" ]] ||
        die "$peer_new_generation does not point to its exact update target"
    elif [[ -n "${before[$name]+set}" ]]; then
      [[ "$target" == "${before[$name]}" ]] ||
        die "pre-existing generation $name changed during the update"
    else
      die "unexpected generation appeared during the update: $name"
    fi
  done < <(find "$directory" -mindepth 1 -maxdepth 1 -print | sort)

  for name in "${!before[@]}"; do
    [[ -L "$directory/$name" ]] ||
      die "pre-existing generation disappeared during the update: $name"
  done
  if [[ "$phase" == complete ]]; then
    [[ "$saw_new" == true ]] || die "$new_generation was not created"
  fi
}

assert_gcroot_transition() {
  local inventory=$1 directory=$2 old_candidate=$3 candidate=$4 phase=$5
  local name target entry
  local -A before=()

  while IFS=$'\t' read -r name target; do
    [[ -n "$name" && -z "${before[$name]+set}" ]] ||
      die "invalid or duplicate entry in $inventory"
    before[$name]=$target
  done <"$inventory"
  [[ "${before[current-home]-}" == "$old_candidate" ]] ||
    die 'current-home pre-state differs from its snapshot'

  while IFS= read -r entry; do
    [[ -L "$entry" ]] || die "unexpected non-symlink Home GC root: $entry"
    name=${entry##*/}
    target="$(readlink -- "$entry")"
    if [[ "$name" == current-home ]]; then
      if [[ "$phase" == complete ]]; then
        [[ "$target" == "$candidate" ]] ||
          die 'current-home does not retain the new candidate'
      else
        [[ "$target" == "$old_candidate" || "$target" == "$candidate" ]] ||
          die 'current-home points outside the old/new update boundary'
      fi
    elif [[ "$name" == new-home ]]; then
      [[ "$phase" == partial && "$target" == "$candidate" ]] ||
        die 'unexpected temporary Home GC root'
    elif [[ -n "${before[$name]+set}" ]]; then
      [[ "$target" == "${before[$name]}" ]] ||
        die "pre-existing Home GC root $name changed during the update"
    else
      die "unexpected Home GC root appeared during the update: $name"
    fi
  done < <(find "$directory" -mindepth 1 -maxdepth 1 -print | sort)

  for name in "${!before[@]}"; do
    [[ -L "$directory/$name" ]] ||
      die "pre-existing Home GC root disappeared during the update: $name"
  done
}

assert_transition_link() {
  local path=$1 old_target=$2 new_target=$3 phase=$4
  if path_is_absent "$path"; then
    [[ "$phase" == partial ]] || die "managed link is absent after update: $path"
    return
  fi
  [[ -L "$path" ]] || die "managed path became a non-symlink: $path"
  if [[ "$old_target" == "$new_target" ]]; then
    [[ "$(readlink -- "$path")" == "$new_target" ]] ||
      die "managed link differs from the unchanged old/new target: $path"
    return
  fi
  case "$(readlink -- "$path")" in
    "$old_target")
      [[ "$phase" == partial ]] || die "managed link still points to the old generation: $path"
      ;;
    "$new_target") ;;
    *) die "managed link points outside the old/new update boundary: $path" ;;
  esac
}

validate_update_transition_surface() {
  local phase=$1 home profiles gcroots
  home=${context[home]}
  profiles=$home/.local/state/nix/profiles
  gcroots=$home/.local/state/home-manager/gcroots
  [[ "$phase" == partial || "$phase" == complete ]] ||
    die 'invalid update-transition validation phase'

  assert_inventory_transition \
    "${context[snapshot]}/profiles.before.tsv" "$profiles" \
    home-manager "${context[old_home_manager_selected]}" \
    "${context[new_home_manager_generation]}" "${context[candidate]}" "$phase" \
    "${context[new_profile_generation]}" "${context[expected_user_environment]}" \
    profile "${context[old_profile_selected]}"
  assert_inventory_transition \
    "${context[snapshot]}/profiles.before.tsv" "$profiles" \
    profile "${context[old_profile_selected]}" \
    "${context[new_profile_generation]}" "${context[expected_user_environment]}" "$phase" \
    "${context[new_home_manager_generation]}" "${context[candidate]}" \
    home-manager "${context[old_home_manager_selected]}"
  assert_gcroot_transition \
    "${context[snapshot]}/gcroots.before.tsv" "$gcroots" \
    "${context[old_candidate]}" "${context[candidate]}" "$phase"

  assert_transition_link "$home/.local/bin/codex" \
    "${context[old_home_files]}/.local/bin/codex" \
    "${context[home_files]}/.local/bin/codex" "$phase"
  assert_transition_link "$home/.cache/.keep" \
    "${context[old_home_files]}/.cache/.keep" \
    "${context[home_files]}/.cache/.keep" "$phase"
  assert_transition_link "$home/.local/state/.keep" \
    "${context[old_home_files]}/.local/state/.keep" \
    "${context[home_files]}/.local/state/.keep" "$phase"

  path_is_absent "$home/.config/environment.d/10-home-manager.conf" ||
    die 'headless update created an environment.d file'
  path_is_absent "$home/.config/systemd/user/tray.target" ||
    die 'headless update created tray.target'
  [[ -f "$home/.codex/config.toml" && ! -L "$home/.codex/config.toml" &&
    -O "$home/.codex/config.toml" ]] ||
    die 'Codex config left the owned regular-file boundary'
}

atomic_symlink() {
  local target=$1 path=$2 temporary=$2.dgx-home-$$
  path_is_absent "$temporary" || die "temporary symlink already exists: $temporary"
  ln -s -- "$target" "$temporary"
  mv -Tf -- "$temporary" "$path"
  [[ -L "$path" && "$(readlink -- "$path")" == "$target" ]] ||
    die "could not atomically select $target at $path"
}

restore_managed_update_link() {
  local path=$1 old_target=$2 new_target=$3
  if [[ -L "$path" && "$(readlink -- "$path")" == "$old_target" ]]; then
    return
  fi
  if ! path_is_absent "$path"; then
    [[ -L "$path" && "$(readlink -- "$path")" == "$new_target" ]] ||
      die "refusing to replace drifted managed path during rollback: $path"
    unlink -- "$path"
  fi
  ln -s -- "$old_target" "$path"
}

unlink_exact_update_link() {
  local path=$1 expected_target=$2
  path_is_absent "$path" && return
  [[ -L "$path" && "$(readlink -- "$path")" == "$expected_target" ]] ||
    die "refusing to remove unexpected update link: $path"
  unlink -- "$path"
}

assert_inventory_exact() {
  local inventory=$1 directory=$2 observed expected
  observed="$(capture_symlink_inventory "$directory")"
  expected="$(cat "$inventory")"
  [[ "$observed" == "$expected" ]] ||
    die "symlink inventory was not restored exactly: $directory"
}

restore_update_config() {
  local snapshot=$1 config=${context[home]}/.codex/config.toml
  local current_sha expected_sha before_sha
  expected_sha=${context[expected_codex_config_sha256]}
  before_sha="$(sha256sum "$snapshot/backup/codex_config" | awk '{print $1}')"

  if path_is_absent "$config"; then
    cp -p -- "$snapshot/backup/codex_config" "$config"
    return
  fi
  [[ -f "$config" && ! -L "$config" && -O "$config" ]] ||
    die 'refusing to replace a non-regular Codex config during rollback'
  current_sha="$(sha256sum "$config" | awk '{print $1}')"
  if [[ "$current_sha" == "$expected_sha" && "$current_sha" != "$before_sha" ]]; then
    cp -p -- "$snapshot/backup/codex_config" "$config"
  elif [[ "$current_sha" != "$before_sha" && "$current_sha" != "$expected_sha" ]]; then
    warn 'Codex config changed after update; preserving the newer mutable file'
  fi
}

rollback_update_snapshot() {
  local snapshot=$1 home profiles gcroots unit current_units
  require_unprivileged
  load_snapshot "$snapshot"
  [[ "${context[format]}" == 2 ]] || die 'snapshot is not a generation update'
  home=${context[home]}
  profiles=$home/.local/state/nix/profiles
  gcroots=$home/.local/state/home-manager/gcroots
  unit=${context[timer_unit]}

  validate_update_transition_surface partial
  disarm_timer "$unit"

  restore_managed_update_link "$home/.local/bin/codex" \
    "${context[old_home_files]}/.local/bin/codex" \
    "${context[home_files]}/.local/bin/codex"
  restore_managed_update_link "$home/.cache/.keep" \
    "${context[old_home_files]}/.cache/.keep" \
    "${context[home_files]}/.cache/.keep"
  restore_managed_update_link "$home/.local/state/.keep" \
    "${context[old_home_files]}/.local/state/.keep" \
    "${context[home_files]}/.local/state/.keep"
  restore_update_config "$snapshot"

  atomic_symlink "${context[old_profile_selected]}" "$profiles/profile"
  atomic_symlink "${context[old_home_manager_selected]}" "$profiles/home-manager"
  atomic_symlink "${context[old_candidate]}" "$gcroots/current-home"
  unlink_exact_update_link "$gcroots/new-home" "${context[candidate]}"
  unlink_exact_update_link "$profiles/${context[new_profile_generation]}" \
    "${context[expected_user_environment]}"
  unlink_exact_update_link "$profiles/${context[new_home_manager_generation]}" \
    "${context[candidate]}"

  assert_inventory_exact "$snapshot/profiles.before.tsv" "$profiles"
  assert_inventory_exact "$snapshot/gcroots.before.tsv" "$gcroots"
  assert_exact_headless_live \
    "${context[old_candidate]}" "${context[old_home_path]}" \
    "${context[old_home_files]}" "${context[old_user_environment]}" \
    "${context[old_home_manager_selected]}" "${context[old_profile_selected]}"
  [[ "$(id -G)" == "${context[user_groups]}" ]] ||
    die 'account group membership changed during Home update rollback'
  current_units="$(capture_protected_units)"
  [[ "$current_units" == "$(cat "$snapshot/protected-units.before.tsv")" ]] ||
    die 'a protected factory/access service restarted during Home update rollback'
  assert_host_health
  [[ -z "$repo_dir" ]] || assert_managed_root_state
  printf 'Rollback completed.\n' >"$snapshot/ROLLED_BACK"
  pass rollback 'previous exact headless Home generation restored; failed candidate history removed'
}

run_update_postflight() {
  local snapshot=$1 home profiles current_config_sha current_units
  load_snapshot "$snapshot"
  [[ "${context[format]}" == 2 ]] || die 'snapshot is not a generation update'
  home=${context[home]}
  profiles=$home/.local/state/nix/profiles

  validate_update_transition_surface complete
  assert_exact_headless_live \
    "${context[candidate]}" "${context[home_path]}" "${context[home_files]}" \
    "${context[expected_user_environment]}" \
    "${context[new_home_manager_generation]}" "${context[new_profile_generation]}"
  current_config_sha="$(sha256sum "$home/.codex/config.toml" | awk '{print $1}')"
  [[ "$current_config_sha" == "${context[expected_codex_config_sha256]}" ]] ||
    die 'Codex config does not match the snapshot-derived update policy'
  "$repo_dir/scripts/reconcile-codex-relaxed-defaults.sh" \
    --check "$home/.codex/config.toml" >/dev/null ||
    die 'Codex permission policy check failed'
  smoke_current_manifest_versions
  [[ "$(id -G)" == "${context[user_groups]}" ]] ||
    die 'account group membership changed during Home update'
  current_units="$(capture_protected_units)"
  [[ "$current_units" == "$(cat "$snapshot/protected-units.before.tsv")" ]] ||
    die 'a protected factory/access service restarted during Home update'
  assert_host_health
  assert_managed_root_state
  pass postflight 'new exact headless Home generation is active; prior generation, root lane, services, and graphical boundary are unchanged'
}

run_update_preflight() {
  require_unprivileged
  require_repository
  require_clean_repository

  local candidate old_candidate dry_run
  candidate="$(activation_candidate)"
  old_candidate="$(readlink -e "$(home_directory)/.local/state/nix/profiles/home-manager" 2>/dev/null || true)"
  info live_candidate "$old_candidate"
  info repository_candidate "$candidate"

  "$nix_bin" "${nix_args[@]}" build --no-link \
    "$(activation_attr)" \
    '.#checks.aarch64-linux.profile-policy' \
    '.#checks.aarch64-linux.codex-cli-policy' \
    '.#checks.aarch64-linux.devbox-policy'
  assert_profile_policy
  assert_root_lane_unchanged
  assert_current_headless_live "$old_candidate"
  assert_host_health
  assert_managed_root_state

  if [[ "$candidate" == "$old_candidate" ]]; then
    "$repo_dir/scripts/reconcile-codex-relaxed-defaults.sh" \
      --check "$(home_directory)/.codex/config.toml" >/dev/null ||
      die 'Codex permission policy check failed'
    smoke_current_manifest_versions
    pass preflight 'live headless Home generation already matches the repository; no update is needed'
    return
  fi

  assert_headless_candidate_structure "$candidate"
  dry_run="$(DRY_RUN=1 VERBOSE=1 "$candidate/activate" 2>&1)" || {
    printf '%s\n' "$dry_run" >&2
    die 'Home Manager update dry run failed'
  }
  grep -F "Would reconcile Armen's non-secret Codex permission defaults" <<<"$dry_run" >/dev/null ||
    die 'update dry run did not keep Codex reconciliation non-mutating'
  ! grep -F 'Activating reloadSystemd' <<<"$dry_run" >/dev/null ||
    die 'update dry run contains a user-systemd activation phase'
  pass preflight 'distinct headless candidate is built; current generation, dry run, root lane, and service boundary are exact'
}

update_headless() {
  run_update_preflight

  local home old_candidate candidate snapshot unit activation_status
  local postflight_status rollback_status
  home="$(home_directory)"
  old_candidate="$(readlink -e "$home/.local/state/nix/profiles/home-manager")"
  candidate="$(activation_candidate)"
  if [[ "$candidate" == "$old_candidate" ]]; then
    pass update 'already current; no snapshot, profile generation, timer, or host state changed'
    return
  fi

  create_update_snapshot "$old_candidate" "$candidate"
  snapshot=$created_snapshot
  load_snapshot "$snapshot"
  unit=${context[timer_unit]}
  info snapshot "$snapshot"
  info scope 'user profile only; prior generation retained; no sudo, root role, service restart, desktop switch, or Tailscale service change'
  arm_update_timer "$snapshot"

  set +e
  "$candidate/activate"
  activation_status=$?
  set -e
  if [[ "$activation_status" -ne 0 ]]; then
    warn "Home Manager update failed with status $activation_status; restoring the prior generation now"
    set +e
    rollback_update_snapshot "$snapshot"
    rollback_status=$?
    set -e
    [[ "$rollback_status" -eq 0 ]] ||
      die 'Home Manager update and its immediate rollback both failed; inspect the armed snapshot evidence'
    exit "$activation_status"
  fi

  set +e
  run_update_postflight "$snapshot"
  postflight_status=$?
  set -e
  if [[ "$postflight_status" -ne 0 ]]; then
    warn 'Home Manager update postflight failed; restoring the prior generation now'
    set +e
    rollback_update_snapshot "$snapshot"
    rollback_status=$?
    set -e
    [[ "$rollback_status" -eq 0 ]] ||
      die 'Home Manager update postflight and its immediate rollback both failed; inspect the snapshot evidence'
    exit "$postflight_status"
  fi

  disarm_timer "$unit"
  run_update_postflight "$snapshot"
  printf 'Update retained.\n' >"$snapshot/RETAINED"
  pass update 'new headless Home generation retained; prior generation kept and automatic rollback disarmed'
  printf 'SNAPSHOT_STAMP=%s\n' "${context[stamp]}"
  printf 'ROLLBACK=%s rollback-update %s\n' "$repo_dir/scripts/dgx-home" "${context[stamp]}"
  printf 'RECORD_DEPLOYMENT=update the committed deployment evidence before the next Home update\n'
}

activate_headless() {
  run_preflight

  local candidate snapshot unit activation_status postflight_status
  candidate="$(activation_candidate)"
  create_snapshot "$candidate"
  snapshot=$created_snapshot
  load_snapshot "$snapshot"
  unit=${context[timer_unit]}
  info snapshot "$snapshot"
  info scope 'user profile only; no sudo, root role, service restart, desktop switch, or Tailscale service change'
  arm_timer "$snapshot"

  set +e
  "$candidate/activate"
  activation_status=$?
  set -e
  if [[ "$activation_status" -ne 0 ]]; then
    warn "Home Manager activation failed with status $activation_status; rolling back now"
    rollback_snapshot "$snapshot"
    exit "$activation_status"
  fi

  set +e
  run_postflight "$snapshot"
  postflight_status=$?
  set -e
  if [[ "$postflight_status" -ne 0 ]]; then
    warn 'Home Manager postflight failed; rolling back now'
    rollback_snapshot "$snapshot"
    exit "$postflight_status"
  fi

  disarm_timer "$unit"
  run_postflight "$snapshot"
  printf 'Activation retained.\n' >"$snapshot/RETAINED"
  pass activation 'headless Home Manager generation one retained; automatic rollback disarmed'
  printf 'SNAPSHOT_STAMP=%s\n' "${context[stamp]}"
  printf 'ROLLBACK=%s rollback %s\n' "$repo_dir/scripts/dgx-home" "${context[stamp]}"
}

show_status() {
  require_unprivileged
  require_repository
  local home candidate profiles
  home="$(home_directory)"
  candidate="$(activation_candidate)"
  profiles=$home/.local/state/nix/profiles
  info candidate "$candidate"
  if [[ -L "$profiles/home-manager" ]]; then
    info home_manager_profile "$(readlink -e "$profiles/home-manager")"
  else
    info home_manager_profile absent
  fi
  if [[ -x "$home/.local/bin/codex" ]]; then
    info codex "$("$home/.local/bin/codex" --version 2>/dev/null || true)"
  else
    info codex absent
  fi
  for command in ncdu lazydocker devbox; do
    if [[ -x "$home/.nix-profile/bin/$command" ]]; then
      info "$command" "$home/.nix-profile/bin/$command"
    else
      info "$command" absent
    fi
  done
  assert_host_health
  pass status 'host health passed; no state changed'
}

action=${1:-}
case "$action" in
  status)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    show_status
    ;;
  preflight)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    run_preflight
    ;;
  activate-headless)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    activate_headless
    ;;
  update-headless)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    update_headless
    ;;
  rollback)
    [[ "$#" -eq 2 ]] || { usage; exit 2; }
    [[ "$2" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || die 'snapshot stamp must be YYYYMMDDTHHMMSSZ'
    require_unprivileged
    require_repository
    rollback_snapshot "$repo_dir/inventory/$(host_name)/private/home-manager-headless/$2"
    ;;
  rollback-update)
    [[ "$#" -eq 2 ]] || { usage; exit 2; }
    [[ "$2" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || die 'snapshot stamp must be YYYYMMDDTHHMMSSZ'
    require_unprivileged
    require_repository
    rollback_update_snapshot "$repo_dir/inventory/$(host_name)/private/home-manager-headless-update/$2"
    ;;
  rollback-snapshot)
    [[ "$#" -eq 2 ]] || { usage; exit 2; }
    rollback_snapshot "$2"
    ;;
  rollback-update-snapshot)
    [[ "$#" -eq 2 ]] || { usage; exit 2; }
    rollback_update_snapshot "$2"
    ;;
  *)
    usage
    exit 2
    ;;
esac
